terraform {
  required_version = ">= 1.6"
  required_providers {
    kaname = {
      source = "PRO-Robotech/kacho"
    }
  }
}

resource "kaname_project" "this" {
  account_id  = var.account_id
  name        = var.name
  description = var.description
  labels      = var.labels
}

# Группы живут в АККАУНТЕ, а не в проекте: одна и та же группа обычно получает права в
# нескольких проектах, и завести её внутри проекта значило бы плодить одноимённые группы,
# состав которых разъедется.
resource "kaname_group" "this" {
  for_each = var.groups

  account_id  = var.account_id
  name        = each.key
  description = each.value
  labels      = var.labels
}

# Служебные учётки — тоже АККАУНТНЫЕ: контракт принимает account_id, поля проекта у них
# нет. Сузить учётку до проекта можно только выдачей прав, а не местом заведения.
resource "kaname_service_account" "this" {
  for_each = var.service_accounts

  account_id  = var.account_id
  name        = each.key
  description = each.value
  labels      = var.labels
}

# Приглашения — тоже АККАУНТНЫЕ: строка членства принадлежит аккаунту, и человек, войдя,
# оказывается участником аккаунта, а не проекта. К ПРОЕКТУ его привязывает выдача прав —
# ниже она и есть единственная ссылка приглашения на проект этого модуля.
#
# Ключ карты в край НЕ УЕЗЖАЕТ ни в одно поле: имени у строки членства нет, край узнаёт
# человека по почте. Ключ адресует запись только внутри Terraform — и потому его смена
# означает не переименование, а ЗАМЕНУ: запись под старым ключом уничтожается (человек
# снимается с аккаунта), под новым заводится приглашение заново. Псевдоним выбирают один
# раз; переносят его `terraform state mv`, а не правкой ключа.
resource "kaname_user_invitation" "this" {
  for_each = var.invitations

  account_id   = var.account_id
  email        = each.value.email
  display_name = each.value.display_name

  # Стартовая выдача ссылается на проект ЭТОГО модуля ПО ИДЕНТИФИКАТОРУ, а не по имени:
  # ссылка строит граф, поэтому создание идёт проект → приглашение, а снос — в обратном
  # порядке. Идентификатор проекта на момент написания конфигурации вызывающему неизвестен
  # (его чеканит край при создании), так что назвать его входом было бы нечем.
  #
  # Проект и роль у края нераздельны: роль требуется тогда и только тогда, когда задан
  # проект. Поэтому проект подставляется РОВНО ТАМ, где названа роль, — иначе приглашение
  # без роли уехало бы с половиной пары и было бы отвергнуто.
  project_id = each.value.role_id == null ? null : kaname_project.this.id
  role_id    = each.value.role_id

  # Метки строка членства получает вторым шагом: само приглашение их не принимает вовсе
  # (край принимает метки только изменяющим запросом). Это забота ресурса, но знать об этом
  # стоит: между приглашением и простановкой есть краткое окно, в котором строка без меток.
  labels = var.labels

  # Запрет входа — не поле края, а действие, и на НЕПРИНЯТОМ приглашении он невозможен:
  # внешней личности у него ещё нет. Умолчание `null` означает «не вмешиваемся»; истина
  # осмысленна для того, кто уже вошёл (в том числе когда приглашение подобрало существующую
  # строку — оно идемпотентно по паре «аккаунт + почта»).
  blocked = each.value.blocked
}
