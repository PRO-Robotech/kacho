# МАШИННАЯ ЛИЧНОСТЬ ЦЕЛИКОМ: служебная учётка и ключи, которыми она входит.
#
# Зачем одним объявлением. Учётка и ключ — два разных ресурса края, и заведённая отдельно
# учётка выглядит готовой, будучи личностью, которой нечем войти: она есть в списках, ей
# выдают права, а войти ею нельзя. Модуль не даёт получить такое состояние по
# невнимательности — `keys` не может быть пустым.
#
# ПРЕДУПРЕЖДЕНИЕ: ЗАКРЫТЫЙ КЛЮЧ ЛЕЖИТ В ФАЙЛЕ СОСТОЯНИЯ ОТКРЫТЫМ.
#
# Край отдаёт материал ключа ОДИН раз — в ответе на выпуск — и повторно не выдаёт никому,
# поэтому Terraform обязан сохранить его у себя, иначе ресурс был бы бесполезен. Пометка
# `sensitive` на выходе скрывает значение в выводе команд и НЕ шифрует состояние. Отсюда
# три следствия, и они не про аккуратность, а про то, кто может войти как эта машина:
#
#   1. состояние проекта, применяющего модуль, хранится там же, где хранят секреты —
#      зашифрованный backend с ограниченным доступом;
#   2. в репозиторий состояние не коммитится никогда, как и его локальные выгрузки;
#   3. кто может прочитать состояние — тот и есть эта машина, со всеми её правами.
#
# Ключ не импортируется (у провайдера нет ImportState) ровно по той же причине: перечитать
# материал нечем, и импорт дал бы состояние, которое выглядит рабочим и не работает.
# Существующий ключ отзывается и выпускается заново.

terraform {
  required_version = ">= 1.6"
  required_providers {
    kaname = {
      source = "PRO-Robotech/kacho"
    }
  }
}

resource "kaname_service_account" "this" {
  account_id  = var.account_id
  name        = var.name
  description = var.description
  labels      = var.labels
}

# Ключ ссылается на учётку ПО ИДЕНТИФИКАТОРУ, а не по имени: ссылка строит граф, и порядок
# здесь несущий с обеих сторон.
#
# На создании: ключ не выпускается раньше, чем учётка существует, — адрес выпуска строится
# из идентификатора владельца.
#
# На сносе: обратный порядок, ключи раньше учётки. Без ссылки Terraform волен снести учётку
# первой, и тогда отзыв ключа уйдёт по адресу владельца, которого уже нет; отзыв, о котором
# Terraform отчитается как о выполненном, на деле не будет выполнен им.
#
# Поля записи раскладываются по атрибутам ПОШТУЧНО, а не передаются объектом: тип записи
# зафиксирован объявлением переменной, а набор атрибутов ресурса шире на вычисляемые поля
# (идентификатор клиента, идентификатор подписи, сам материал ключа) — общего типа у них
# нет, и передача целиком дала бы отказ, не называющий ни поля, ни причины.
resource "kaname_service_account_key" "this" {
  for_each = var.keys

  service_account_id = kaname_service_account.this.id

  # `null` означает «не называть»: край подставит ответственного сам. Пробрасывается КАК
  # ЕСТЬ, без подстановки пустой строки вместо null, — пустая строка на проводе от
  # отсутствия неотличима, но в состоянии осталась бы утверждать пустоту про ключ, у
  # которого ответственный есть, и apply кончился бы отказом о несогласованном результате.
  created_by_user_id = var.created_by_user_id

  name        = "${var.name}-${each.key}"
  description = each.value.description
  labels      = var.labels

  # null у записи означает «умолчание модуля», а не «умолчание края». Краевой ноль — это не
  # «бессрочно», а «взять умолчание установки»: величина конечна, но задаётся настройкой той
  # установки, куда пришёл apply, и в конфигурации не видна. Молча наследовать её значило бы
  # отдавать решение о сроке тому, кто его не принимал.
  ttl_seconds = each.value.ttl_seconds == null ? var.key_ttl_seconds : each.value.ttl_seconds

  # Здесь null означает именно «умолчание края»: назначение токена — предметное решение
  # владельца ключа, и подставлять за него что-то своё модуль не вправе.
  audience = each.value.audience
}
