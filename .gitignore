# Go build/test artefacts
*.test
*.out
/bin/
/dist/
coverage*.txt

# Локальные креды/секреты — НИКОГДА в git
pem
*.pem
*.key
kubeconfig*
.env

# Агентские worktree/scratch
.claude/worktrees/

# Оверлеи с секретами кластера — НИКОГДА в git.
# values.fe3455-ory.yaml несёт hydra.config.dsn (креды БД) и прочий per-cluster секрет;
# в kacho-deploy он был gitignored, при переезде в монорепу правило не поехало —
# и любой `git add -A` закоммитил бы его в ПУБЛИЧНЫЙ репозиторий.
#
# ВНИМАНИЕ (2026-08-11): под этот шаблон нельзя заводить ПОСАДКУ. Пока посадка
# провайдеров личности лежала в том же файле, что и креды, она была невидима не
# только git, но и ревью, и всем гейтам: боевой кластер поднимался с режимом
# разработки у kratos, а рендер CI и таблица стеков знали о боевой цепочке три
# слоя из четырёх. Посадка вынесена в ОТСЛЕЖИВАЕМЫЙ
# deploy/helm/umbrella/values.fe3455-ory-posture.yaml (под шаблон не подпадает —
# он требует окончания ровно `-ory.yaml`), и разделение проверяется:
# cutover-fe3455.sh отказывается разворачивать набор, если в слое кредов появилась
# координата, которой нет в его списке допустимых.
**/values.*-ory.yaml
**/values.*-secrets.yaml

# Отчёты прогонов newman, отложенные в сторону при верификации (out-stale-<ts>/).
# Артефакты запуска, не исходники — в репозиторий не попадают.
services/*/tests/newman/out-stale-*/

# Файлы окружения newman переписываются посевом фикстур на КАЖДОМ прогоне и содержат
# живые Bearer-токены (в production-посадке — RS256 с 4-часовым сроком). Это артефакты
# прогона, а не исходники: закоммиченные значения всё равно протухают и вводят в
# заблуждение. В репозитории остаётся только шаблон с плейсхолдерами (*.template.json).
#
# Рабочую копию создаёт scripts/run.sh каждой суиты (cp из *.template.json, если файла
# нет; существующий не перетирается), а посев потом ДОПИСЫВАЕТ в неё креды и id.
# Здесь раньше было написано, что копию «генерирует посев» — это было неправдой:
# patch-env.py и setup.sh только патчат уже существующий файл и молча пропускают
# отсутствующий, так что на свежем клоне все восемь прогонщиков падали на
# `missing env` ещё до запуска newman. Материализация обязана оставаться частью пути
# прогона: шаг, который нужно вспомнить и сделать руками, рано или поздно не делается.
#
# Правило ниже — договорённость, и `git add -f` её не соблюдает, а новый набор про неё
# не знает. Что кред не доедет до индекса, держит проверка, а не это правило:
# internal/repohygiene/committedcredential_test.go (PRO-Robotech/kacho#70).
services/*/tests/newman/environments/local.postman_environment.json
gateway/tests/newman/environments/local.postman_environment.json

# Скомпилированные бинарники сервисов не коммитятся: артефакт сборки,
# 37 МБ в публичном репозитории и источник расхождения с исходником.
/kaname
/kacho-*
!/kacho-*/

# Скомпилированный python — производное от исходника; в дереве держать нечего,
# а .pyc минтера успел утащить туда общий подписной ключ (греп по исходникам его
# не видел — байты, не строки).
__pycache__/
*.pyc

# Кэш линтера, перенесённый в рабочую копию (см. lint-цели Makefile'ов). Общий
# кэш машины ключуется содержимым пакета, а не деревом, поэтому соседняя копия
# того же модуля возвращает разбор ЧУЖИХ файлов; перенос кэша внутрь копии это
# снимает — а раз он внутри дерева, то обязан быть невидим для git.
/.cache/

# Рабочая настройка редактора Markdown. Четыре файла лежали внутри инженерных
# записок iam и описывали ЧУЖОЕ рабочее место: раскладку панелей, тему, набор
# включённых плагинов. К продукту это не относится ничем, а «последний открытый
# файл» менялся от каждого сеанса чтения — то есть дерево шумело правками, за
# которыми не стоит изменения продукта.
.obsidian/

# Рабочее пространство Go — только локальное, в индекс не идёт.
#
# В дереве один модуль, поэтому `go.work` здесь не нужен вовсе; запись оставлена, чтобы
# случайно созданный файл не уехал в индекс и не поменял молча смысл `./...` для всех.
go.work
go.work.sum

# Рабочий каталог и локальное состояние Terraform/OpenTofu.
#
# `.terraform/` — установленные модули и провайдеры конкретной машины; `*.tfstate` —
# состояние, которое НИКОГДА не место в репозитории: в нём лежат идентификаторы живой
# инфраструктуры, а у публичного репозитория нет непубличных мест.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*

# Выходы локального прогона gosec (scripts/gosec-scan-modules.sh).
#
# В конвейере они эфемерны, а на машине разработчика ложатся в корень дерева —
# и отчёт сканера безопасности не место в репозитории: он несёт координаты
# находок, то есть ровно ту сборку, которую запрещает публичность обоих репо.
gosec.sarif
gosec-census.txt
gosec-scan-failed
gosec-*-summary.txt
gosec-*.sarif
gosec-merge-err.txt
