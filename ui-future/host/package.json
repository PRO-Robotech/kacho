{
  "name": "kacho-ui-future-host",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --host 0.0.0.0 --strictPort",
    "prebuild": "node ../scripts/copy-monaco.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "pretest": "node ../scripts/deps-ready.mjs",
    "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --silent --testTimeout=30000 --forceExit --ci",
    "typecheck": "tsc -b --noEmit",
    "check": "npm run lint && npm run format:check",
    "lint": "npm run lint:js && npm run lint:css && npm run typecheck",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix && npm run format",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "format": "prettier . --check",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "predev": "node ../scripts/copy-monaco.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "antd": "^6.3.7",
    "lucide-react": "^1.30.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
