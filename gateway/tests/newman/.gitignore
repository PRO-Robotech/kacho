# Newman run artifacts — generated by tests/newman/scripts/run.sh.
# Never commit: a stale out/<name>.json is read by the shared CI gate
# (assert-suites-green.sh walks collections/*.json against out/<name>.json), so a
# leftover report from a local run can resurface as a phantom verdict for a
# collection that did not run in this pass.
out/
__pycache__/
