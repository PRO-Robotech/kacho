      "name": "IAM-AB-SIA-12-EDGE-LIST-BY-ACCOUNT — IAM-AB-SIA-12: GET /accounts/not-an-id/accessBindings → sync 400 INVALID_ARGUMENT (3), \"invalid resource id 'not-an-id'\" from the edge; a well-formed absent account on the same route passes on to the permission check (403)",
      "description": "class:NEG | class:VAL | priority:P0",
      "item": [
        {
          "name": "sia-malformed-parity-with-list-by-account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iam/v1/accounts/not-an-id/accessBindings?pageSize=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iam",
                "v1",
                "accounts",
                "not-an-id",
                "accessBindings"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// per-step auth: bearer from env 'jwtAccountAdminA'",
                  "const __t = pm.environment.get('jwtAccountAdminA') || pm.variables.get('jwtAccountAdminA') || '';",
                  "if (__t) {",
                  "  pm.request.headers.upsert({key: 'Authorization', value: 'Bearer ' + __t});",
                  "} else {",
                  "  pm.test('[УСЛОВИЕ НЕ СОЗДАНО] harness config: jwtAccountAdminA is set (subject under test)', () => {",
                  "    pm.expect.fail('jwtAccountAdminA is not set — the authz-fixture seed (tests/authz-fixtures/setup.sh, or prodseed_all.py under production posture) did not provide this subject. Running the step anonymously would test a DIFFERENT principal and pass for the wrong reason.');",
                  "  });",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.expect(pm.response.code, JSON.stringify(pm.response.text())).to.eql(400));",
                  "pm.test('grpc code 3 (INVALID_ARGUMENT)', () => {",
                  "  let j; try { j = pm.response.json(); } catch (e) { j = {}; }",
                  "  pm.expect(j.code, JSON.stringify(j)).to.eql(3);",
                  "});",
                  "pm.test('у цели авторизации отказ формы производит край, и текст его', () =>",
                  "  pm.expect(pm.response.json().message, pm.response.text())",
                  "    .to.eql(\"invalid resource id 'not-an-id'\"));"
                ]
              }
            }
          ]
        },
