    {
      "name": "IBT-10-RS256-TAMPERED-SIGNATURE-REJECTED — genuine bootstrap Bearer with one signature byte flipped → 401",
      "description": "class:AUTHN | class:NEG | class:SEC | class:CONF | priority:P0",
      "item": [
        {
          "name": "list-accounts-with-tampered-signature",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iam/v1/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iam",
                "v1",
                "accounts"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _base = pm.environment.get('jwtBootstrap') || pm.variables.get('jwtBootstrap') || '';",
                  "if (!_base) {",
                  "  pm.test('harness config: jwtBootstrap is set (нечего портить)', () => {",
                  "    pm.expect.fail('jwtBootstrap не задан — посев фикстур (tests/authz-fixtures/setup.sh) не выдал предъявителя. Испортить подпись не у чего, а запрос без заголовка проверил бы анонимный доступ, то есть другой кейс.');",
                  "  });",
                  "  pm.execution.skipRequest();",
                  "} else {",
                  "  const _s = _base.split('.');",
                  "  const _sig = _s[2];",
                  "  const _c = _sig[0];",
                  "  const _flipped = (_c === 'A' ? 'B' : 'A') + _sig.slice(1);",
                  "  pm.request.headers.upsert({ key: 'Authorization',",
                  "    value: 'Bearer ' + _s[0] + '.' + _s[1] + '.' + _flipped });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _sent = (pm.request.headers.get('Authorization') || '');",
                  "const _tok = _sent.replace(/^Bearer /, '');",
                  "const _base = pm.environment.get('jwtBootstrap') || pm.variables.get('jwtBootstrap') || '';",
                  "pm.test('полоса «внешний поставщик»: отправлен предъявитель, отличный от исходного', () => {",
                  "  pm.expect(_tok, 'отправленный предъявитель').to.not.eql(_base);",
                  "});",
                  "pm.test('заголовок и тело совпадают с исходными — испорчена ТОЛЬКО подпись', () => {",
                  "  const _a = _tok.split('.');",
                  "  const _b = _base.split('.');",
                  "  pm.expect(_a[0], 'заголовок').to.eql(_b[0]);",
                  "  pm.expect(_a[1], 'тело').to.eql(_b[1]);",
                  "  pm.expect(_a[2], 'подпись').to.not.eql(_b[2]);",
                  "  pm.expect(_a[2].length, 'длина подписи').to.eql(_b[2].length);",
                  "});",
                  "pm.test('изменён ровно один символ подписи, и он НЕ последний (у последнего часть бит — заполнение, байты совпали бы)', () => {",
                  "  const _a = _tok.split('.')[2];",
                  "  const _b = _base.split('.')[2];",
                  "  const _diff = [];",
                  "  for (let i = 0; i < _b.length; i++) { if (_a[i] !== _b[i]) _diff.push(i); }",
                  "  pm.expect(_diff.length, 'позиции расхождения: ' + JSON.stringify(_diff)).to.eql(1);",
                  "  pm.expect(_diff[0], 'позиция расхождения (последняя — ' + (_b.length - 1) + ')').to.not.eql(_b.length - 1);",
                  "});",
                  "pm.test('край ответил 401 — предъявитель не принят', () => {",
                  "  pm.expect(pm.response.code, pm.response.text()).to.eql(401);",
                  "});",
                  "pm.test('grpc code 16 (Unauthenticated), а не 7 (PermissionDenied)', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.code, JSON.stringify(j)).to.eql(16);",
                  "});",
                  "pm.test('ответ несёт вызов RFC 6750 (WWW-Authenticate: Bearer …)', () => {",
                  "  const h = pm.response.headers.get('WWW-Authenticate') || '';",
                  "  pm.expect(h.startsWith('Bearer'), 'WWW-Authenticate: ' + h).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
