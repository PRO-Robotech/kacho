                  "const __t = pm.environment.get('jwtUserTokenPlatformIssuer') || pm.variables.get('jwtUserTokenPlatformIssuer') || '';",
                  "if (__t) {",
                  "  pm.request.headers.upsert({key: 'Authorization', value: 'Bearer ' + __t});",
                  "} else {",
                  "  pm.test('harness config: jwtUserTokenPlatformIssuer is set (subject under test)', () => {",
