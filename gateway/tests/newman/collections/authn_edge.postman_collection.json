                  "  });",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ПРОИЗВОДИТЕЛЬ ВХОДА: сначала — что отправили, потом — что ответили.",
                  "const _sent = (pm.request.headers.get('Authorization') || '');",
                  "const _tok = _sent.replace(/^Bearer /, '');",
                  "pm.test('проба отправила Bearer (иначе это анонимный кейс, а не этот)', () => {",
                  "  pm.expect(_sent.startsWith('Bearer '), 'Authorization как отправлен: ' + _sent).to.eql(true);",
                  "});",
                  "pm.test('отправленный предъявитель — JWS из 3 сегментов', () => {",
                  "  pm.expect(_tok.split('.').length, _tok).to.eql(3);",
                  "});",
                  "pm.test(\"заголовок отправленного предъявителя объявляет alg=ES256\", () => {",
                  "  const _cj = require('crypto-js');",
                  "  const _b64 = _tok.split('.')[0].replace(/-/g, '+').replace(/_/g, '/');",
                  "  const _h = JSON.parse(_cj.enc.Utf8.stringify(_cj.enc.Base64.parse(_b64)));",
                  "  pm.expect(_h.alg, JSON.stringify(_h)).to.eql('ES256');",
                  "});",
                  "const _cj3 = require('crypto-js');",
                  "function _seg3(t, i) {",
                  "  const b = t.split('.')[i].replace(/-/g, '+').replace(/_/g, '/');",
                  "  return JSON.parse(_cj3.enc.Utf8.stringify(_cj3.enc.Base64.parse(b)));",
                  "}",
                  "function _claim3(p, k) {",
                  "  if (p && p[k]) { return p[k]; }",
                  "  const e = (p && p.ext_claims) || {};",
                  "  return e[k] || '';",
                  "}",
                  "pm.test('заголовок объявляет тип токена доступа (at+jwt)', () => {",
                  "  const _h = _seg3(_tok, 0);",
                  "  pm.expect(_h.typ, JSON.stringify(_h)).to.eql('at+jwt');",
                  "});",
                  "pm.test('край принял ПЕРСОНАЛЬНЫЙ токен нашей чеканки', () => {",
                  "  pm.expect(pm.response.code, pm.response.text()).to.eql(200);",
                  "});",
                  "pm.test('вердикт отзыва ПОЛУЧЕН: край не ответил 503', () => {",
