                  "  pm.test('[УСЛОВИЕ НЕ СОЗДАНО] harness config: stepUpUnverifiedHumanSession is set (seed slot) — session bearer of the step-up human seeded by prodseed_matrix.py (F8-S7-80)', () => {",
                  "    pm.expect.fail('stepUpUnverifiedHumanSession is not set — the authz-fixture seed (tests/authz-fixtures/prodseed_matrix.py) did not provide this slot. The step would run with an empty identifier and its refusal would read as a finding about the product.');",
                  "  });",
                  "  pm.execution.skipRequest();",
                  "}",
                  "if (!pm.environment.get('f8s780NToken')) { pm.execution.skipRequest(); }",
                  "const __cookie = ((pm.environment.get('stepUpUnverifiedHumanSession') ? 'kaname_session' + '=' + pm.environment.get('stepUpUnverifiedHumanSession') + '; ' : '') + (pm.environment.get('f8s780NForm') ? 'kaname_form' + '=' + pm.environment.get('f8s780NForm') + '; ' : '')).replace(/; $/, '');",
                  "if (__cookie) { pm.request.headers.upsert({key: 'Cookie', value: __cookie}); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('begin-unverified: запрос получил ОТВЕТ (пусто ⇒ транспорт, а не поведение)', () => {",
                  "  pm.expect(pm.response, 'ответа нет вовсе — сеть/TLS/таймаут, а не отказ края').to.not.be.undefined;",
                  "  pm.expect(pm.response.code, 'HTTP-кода нет — обмен не завершился').to.be.a('number');",
                  "});",
                  "pm.test('status 403', () => pm.expect(pm.response.code, JSON.stringify(pm.response.text())).to.eql(403));",
                  "pm.test('grpc code 7 (PERMISSION_DENIED)', () => {",
                  "  let j; try { j = pm.response.json(); } catch (e) { j = {}; }",
                  "  pm.expect(j.code, JSON.stringify(j)).to.eql(7);",
                  "});",
                  "pm.test('error message exactly equals \"email address is not verified: confirm it with the code from the letter (POST /iam/v1/auth/verify-email/confirm)\"', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.message, JSON.stringify(j)).to.eql(\"email address is not verified: confirm it with the code from the letter (POST /iam/v1/auth/verify-email/confirm)\");",
                  "});",
                  "pm.test('details[] carries ErrorInfo with reason EMAIL_NOT_VERIFIED', () => {",
                  "  let j; try { j = pm.response.json(); } catch (e) { j = {}; }",
                  "  const infos = (Array.isArray(j.details) ? j.details : []).filter(d => d && d['@type'] === 'type.googleapis.com/google.rpc.ErrorInfo');",
                  "  pm.expect(infos.length, JSON.stringify(j)).to.eql(1);",
                  "  pm.expect(infos[0].reason, JSON.stringify(j)).to.eql('EMAIL_NOT_VERIFIED');",
                  "});",
                  "pm.test('content-type is application/json', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.match(/^application\\/json/));",
                  "pm.test('body keys are exactly code, message, details', () => {",
                  "  let j; try { j = pm.response.json(); } catch (e) { j = {}; }",
                  "  pm.expect(Object.keys(j).sort(), JSON.stringify(j)).to.eql(['code', 'details', 'message']);",
                  "});",
                  "pm.test('no kaname_session cookie is issued on a refusal', () => pm.expect(pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie' && h.value.startsWith('kaname_session=')).length, JSON.stringify(pm.response.headers.all())).to.eql(0));",
                  "pm.test('body is byte-equal to the edge answer on POST /iam/v1/auth/step-up in the same state', () => {",
                  "  const ref = pm.environment.get('f8s780NStepUpBody') || '';",
