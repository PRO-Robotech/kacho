                  "});",
                  "pm.test('status 200', () => pm.expect(pm.response.code, JSON.stringify(pm.response.text())).to.eql(200));",
                  "pm.test('csrf step-up-access-key-begin: csrfToken is a non-empty string', () => {",
                  "  let j; try { j = pm.response.json(); } catch (e) { j = {}; }",
                  "  pm.expect(j.csrfToken, JSON.stringify(j)).to.be.a('string').and.not.empty;",
                  "  pm.environment.set('f8s780PToken', j.csrfToken);",
                  "});",
                  "{",
                  "  const __sc = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie' && h.value.startsWith('kaname_form='));",
                  "  pm.test('csrf step-up-access-key-begin: response sets the kaname_form cookie', () => pm.expect(__sc.length, JSON.stringify(pm.response.headers.all())).to.eql(1));",
                  "  if (__sc.length === 1) { pm.environment.set('f8s780PForm', __sc[0].value.split(';')[0].slice('kaname_form='.length)); }",
