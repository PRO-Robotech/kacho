              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('csrf step-up-access-key-begin: запрос получил ОТВЕТ (пусто ⇒ транспорт, а не поведение)', () => {",
                  "  pm.expect(pm.response, 'ответа нет вовсе — сеть/TLS/таймаут, а не отказ края').to.not.be.undefined;",
