#!/usr/bin/env bash
# Copyright (c) PRO-Robotech
# SPDX-License-Identifier: BUSL-1.1
#
# Хук отправки: то, что можно узнать локально, узнаётся ДО конвейера.
#
# ЗАЧЕМ ХУК, А НЕ ПУНКТ В РЕГЛАМЕНТЕ. Правило «прогоняй локально» существовало и
# соблюдалось ровно до первой спешки: конвейер оказывался первым читателем кода и
# отвечал через двадцать минут. Обещание держится гейтом, а не памятью.
#
# ЧТО ГОНЯЕТСЯ. Быстрые группы: генерация и совместимость контракта, сборка,
# статический анализ, короткие пробы, линтеры, gosec — в ТОЙ ЖЕ форме, что в
# конвейере. Медленное (кластер, сквозные прогоны, интеграция с контейнерами)
# здесь НЕ гоняется и названо в выводе прогонщика прямо. Отправка одних
# удалений ссылок не гоняет НИЧЕГО: ревизии в ней нет (#2825).
#
# КАК ОБОЙТИ И ПОЧЕМУ ЭТО ЗАКОННО. `git push --no-verify` либо
# `KACHO_SKIP_PREPUSH=1`. Обход нужен: отправка ветки-черновика ради обсуждения —
# законное действие. Но он ЯВНЫЙ: обойти можно, не заметив — нельзя.
#
# Установка: `make install-hooks` — цель кладёт в `.git/hooks` переходник,
# исполняющий ЭТОТ файл из той рабочей копии, из которой идёт отправка.
# Проверить провязку в любой момент: `make check-hooks`.
#
# `git config core.hooksPath scripts/hooks` здесь НЕ советуется, хотя и работает:
# он перебивает `.git/hooks` целиком, и всё, что там уже лежало, перестаёт
# исполняться молча. Разбор — в шапке scripts/hooks/install.sh.
set -uo pipefail

if [ "${KACHO_SKIP_PREPUSH:-0}" = "1" ]; then
    echo "pre-push: пропущен по KACHO_SKIP_PREPUSH=1 — локальные проверки НЕ выполнялись" >&2
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"

# ОКРУЖЕНИЕ GIT НЕ НАСЛЕДУЕТСЯ ПРОВЕРКАМИ. `git push` запускает хук с
# выставленным `GIT_DIR` (а при иных вызовах — и `GIT_WORK_TREE`/`GIT_INDEX_FILE`),
# и дальше его наследует ВСЁ, что хук запускает, — в том числе `go test`.
#
# Цена наследования измерена, а не предположена. В дереве полтора десятка проб
# заводят синтетический репозиторий во временном каталоге (`git init` + `git add
# -A`), задавая рабочий каталог команды и полагаясь на то, что git определит
# репозиторий по нему. С выставленным `GIT_DIR` git его НЕ определяет: переменная
# сильнее рабочего каталога — и `add -A` фикстуры пишет в индекс ЭТОЙ рабочей
# копии. Индекс схлопывается до нескольких записей фикстуры.
#
# Дальше ложь расходится кругами: гейты, читающие состав дерева через `git
# ls-files` (`pkg/treecorpus`), видят пустой индекс и честно падают с
# «прочитано ноль» — то есть отказ получают проверки, ни к чему не причастные,
# а виновник остаётся невидимым. Замер на этом дереве: те же пакеты без
# `GIT_DIR` — индекс цел (6994 записи), падений 0; с `GIT_DIR` — индекс 3
# записи, падений 119.
#
# Поэтому хук — граница, на которой окружение обрывается. В конвейере класс не
# воспроизводится by construction: там проверки запускает не git, поэтому
# «зелёный конвейер» его никогда бы и не показал.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX

# ─────────────────────────────────────────────────────────────────────────────
# ЧТО УЕЗЖАЕТ — ЧИТАЕТСЯ ОДИН РАЗ, И ОТСЮДА ОТВЕЧАЕТ НА ВСЕ ВОПРОСЫ
# ─────────────────────────────────────────────────────────────────────────────
#
# git передаёт хуку на вход строки `<local_ref> <local_sha> <remote_ref>
# <remote_sha>` — по одной на отправляемую ссылку. Это авторитетный ответ на
# вопрос «что уедет этой отправкой»; ни точка ветвления, ни имя ветки рабочей
# копии его не заменяют.
#
# Раньше вход читал только производитель диапазона, а решение о пропуске
# черновика выводилось из `HEAD` — два разных ответа на ОДИН вопрос, и оба
# следствия расхождения наблюдались (#2594). Пропуск не срабатывал там, где
# обязан: отправка черновика НЕ ИЗ ЕГО ВЕТКИ (`git push origin
# <ветка>:refs/heads/wip/<имя>`, копия с отсоединённой головой) давала имя
# `HEAD` либо чужой ветки и гнала полный прогон. И срабатывал там, где не
# должен: копия, стоящая на `wip/z`, пропускала отправку `feature/y` — то есть
# непроверенное уезжало под видом проверенного, и это следствие дороже первого.
#
# Поэтому вход читается ЗДЕСЬ, ОДИН раз, и дальше раздаётся производителям:
# второго источника ответа в хуке нет. Читается только когда вход ЕСТЬ: при
# ручном вызове с терминала `cat` ждал бы ввода вечно.
push_input=""
if [ ! -t 0 ]; then
    push_input="$(cat)"
fi
# Имя удалённого репозитория git передаёт первым аргументом; оно нужно строке
# постусловия и берётся здесь, рядом со входом отправки.
PUSH_REMOTE_NAME="${1:-origin}"

zero_sha="0000000000000000000000000000000000000000"
push_refs_total=0
push_refs_draft=0
push_refs_deleted=0
push_remote_refs=""
push_tips=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ -n "${remote_ref:-}" ] || continue
    push_refs_total=$((push_refs_total + 1))
    push_remote_refs="$push_remote_refs ${remote_ref#refs/heads/}"
    case "$remote_ref" in
        refs/heads/wip/* | refs/heads/tmp/*) push_refs_draft=$((push_refs_draft + 1)) ;;
    esac
    # Нулевой `<local_sha>` — удаление ссылки: вершины у неё нет и судить нечего.
    if [ "$local_sha" = "$zero_sha" ]; then
        push_refs_deleted=$((push_refs_deleted + 1))
        continue
    fi
    push_tip="$(git rev-parse --verify --quiet "$local_sha^{commit}" 2> /dev/null)" || continue
    push_tips="$push_tips$push_tip
"
done <<< "$push_input"
push_remote_refs="${push_remote_refs# }"
branch="$(git rev-parse --abbrev-ref HEAD)"
announce_ref="${push_remote_refs%% *}"
[ -n "$announce_ref" ] || announce_ref="$branch"

# ПОСТУСЛОВИЕ ОТПРАВКИ: код ЭТОГО хука — исход ПРОВЕРОК, а не отправки.
#
# Между `git push` и его исходом всегда стоит посредник, и код возврата говорит о
# посреднике. Замеры 2026-09-22 (оба на этом дереве): отправка отчиталась
# `exit code 0` при настоящем 128 — соединение молчало 831 секунду, пока шли
# проверки, и его оборвали по простою, пакет не ушёл; и «exit code 0» от
# харнесса, переведшего команду в фон на пороге 120 с — настоящий код там тоже
# был нулём, но это СОВПАДЕНИЕ. Порог этот хук перешагивает почти всегда.
#
# Поэтому хук печатает то, чем отправка проверяется на самом деле: ссылка на
# сервере равна отправленной sha, а удалённой ссылки на сервере нет. Печать, а
# не код: код у читателя могут отнять. Причину обрыва лечит keepalive клона
# (`scripts/hooks/install.sh`).
#
# Определена здесь, рядом со входом, а не в конце: её зовёт и ветвь одних
# удалений ниже, которая до прогона не доходит.
postcondition_note() {
    local remote="${PUSH_REMOTE_NAME:-origin}" _lref lsha rref _rsha
    echo "" >&2
    echo "pre-push: код этого хука — исход ПРОВЕРОК, а не отправки." >&2
    if [ -z "$push_input" ]; then
        echo "  Что отправляется, хук не читал (вход пуст) — подтвердите сами:" >&2
        echo "    git ls-remote $remote <ссылка>   # обязана совпасть с отправленной sha" >&2
        return 0
    fi
    if [ "$push_refs_deleted" -eq 0 ]; then
        echo "  Отправка состоялась, только если ссылка на сервере равна отправленной sha:" >&2
    else
        echo "  Отправка состоялась, только если ссылка на сервере равна отправленной sha," >&2
        echo "  а удалённой ссылки на сервере нет:" >&2
    fi
    while read -r _lref lsha rref _rsha; do
        [ -n "${rref:-}" ] || continue
        if [ "$lsha" = "$zero_sha" ]; then
            echo "    git ls-remote $remote $rref   # ожидается пустой вывод" >&2
            continue
        fi
        echo "    git ls-remote $remote $rref   # ожидается $lsha" >&2
    done <<< "$push_input"
}

# ОТПРАВКА ОДНИХ УДАЛЕНИЙ — СУДИТЬ НЕЧЕГО, И ПРОГОНА НЕТ (#2825).
#
# Удаление ссылки не несёт ревизии: ни вершины, ни диапазона, ни дерева. Прогон
# здесь шёл всё равно — над РАБОЧЕЙ КОПИЕЙ, из которой отправляют, то есть о
# дереве, которого отправка не касается (тот же класс, что #2594). Следствие
# воспроизведено на одноразовом голом удалённом репозитории: `git push origin
# --delete <ветка>` звал прогонщик с группами `proto go`, красная по своей причине
# копия отвергала удаление, и ссылка оставалась на сервере. Снятие влитой ветки
# становилось выполнимым только в обход хука.
#
# Поэтому отправка, КАЖДАЯ строка входа которой — удаление, выходит нулём до
# прогона и говорит об этом своей строкой: «проверок не было» обязано быть
# отличимо от «проверки зелёные». Смешанная (удаление и вершина) сюда не попадает
# и судится по вершине, как прежде: у вершины есть читатель, и вердикт ей нужен.
#
# СОХРАННОСТЬ удаляемой головы хук НЕ стережёт — ни здесь, ни в какой другой
# ветви. Это решение, а не пропуск. Ветку задачи вливают в ветку волны и снимают,
# пока волна до ствола не дошла (так снималась #2828), поэтому признак «голова —
# предок ствола» отвергал бы ровно законное снятие, а ответ по локальным ссылкам
# удалённого отслеживания зависел бы от их свежести. Что снимаемое влито,
# подтверждает тот, кто снимает.
#
# ПЕРВОЕ УСЛОВИЕ — «строки есть» — не лишнее. «Каждая строка — удаление» на
# пустом входе истинно, как любое «для всех» на пустом множестве. Без него
# пустой вход уходил бы нулём мимо прогона со строкой «только удаление ссылок
# ()», хотя удалений в нём нет. Пустой вход судит рабочую копию; ответ и довод —
# в subject_tree_for_push. Держит оба условия проба
# (scripts/hooks/prepush-range-inject.sh, раздел «одни удаления»).
push_is_deletion_only() {
    [ "$push_refs_total" -gt 0 ] && [ "$push_refs_deleted" -eq "$push_refs_total" ]
}

if push_is_deletion_only; then
    echo "pre-push: отправка несёт только удаление ссылок ($push_remote_refs) — ревизии в ней нет," >&2
    echo "          судить нечего: проверки содержимого НЕ выполнялись. Это не «зелено»." >&2
    postcondition_note
    exit 0
fi

# push_is_draft — ЧЕРНОВИК ЛИ ЭТА ОТПРАВКА, спрошено у входа git.
#
# Черновик — отправка, ВСЕ удалённые ссылки которой личные (`wip/` либо `tmp/`).
# Смешанная черновиком не считается: в ней есть ссылка, которую кто-то будет
# читать, и вердикт ей нужен.
#
# Входа нет вовсе — значит ревизии отправка не несёт: хук позвали руками либо
# git позвал его на отправке без изменений, и решать не о чем. ТОЛЬКО тогда
# берётся имя ветки рабочей копии, и об этом говорится вслух: умолчание, о
# котором не сказано, неотличимо от того самого дефекта.
push_is_draft() {
    if [ "$push_refs_total" -eq 0 ]; then
        case "$branch" in
            wip/* | tmp/*) return 0 ;;
            *) return 1 ;;
        esac
    fi
    [ "$push_refs_draft" -eq "$push_refs_total" ]
}

if push_is_draft; then
    if [ -z "$push_remote_refs" ]; then
        echo "pre-push: входа от git нет (ручной вызов либо отправка без изменений) — решено по ветке рабочей копии" >&2
        echo "          «$branch»: черновик, проверки пропущены" >&2
    else
        echo "pre-push: все ссылки отправки объявлены черновиками ($push_remote_refs) — проверки пропущены" >&2
    fi
    exit 0
fi
if [ "$push_refs_draft" -gt 0 ]; then
    echo "pre-push: отправка СМЕШАННАЯ — черновиков $push_refs_draft из $push_refs_total ссылок." >&2
    echo "          Черновиком она не считается: у не-черновой ссылки есть читатель, и вердикт ей нужен." >&2
fi

# ЧТО ИМЕННО УЕЗЖАЕТ — СПРАШИВАЕМ У GIT, А НЕ ВЫВОДИМ ИЗ ИМЕНИ ВЕТКИ.
#
# git передаёт хуку на вход строки `<local_ref> <local_sha> <remote_ref>
# <remote_sha>` — по одной на каждую отправляемую ссылку. Это авторитетный
# ответ на вопрос «что уедет этой отправкой»; ни точка ветвления, ни
# вышестоящая ветка его не заменяют.
#
# САМО ПОСТРОЕНИЕ ДИАПАЗОНА — отдельным производителем
# (scripts/hooks/prepush-range.sh), по той же причине, по которой отдельно
# живёт набор групп: это РЕШЕНИЕ, оно ошибалось молча, и проверить его
# выражением внутри хука можно было только полной отправкой.
#
# Ошибалось оно так (#805): у ПЕРВОЙ отправки ссылки на origin ещё нет,
# базу приходится выбирать, и здесь стояло «ствол». Для ветки, отведённой от
# накопительной релизной линии, трёхточечный диапазон от ствола вбирает ВСЮ
# работу линии — и хук требовал проверок консоли у ветки, не тронувшей её ни
# одним файлом. Разбор выбора базы — в шапке производителя.
# Вход раздаётся из переменной, а не из общего потока: прочитан он уже выше, и
# второго чтения у потока нет. Пустой вход передаётся ПУСТЫМ потоком, а не
# пустой строкой: строка из одних пробелов — это «ссылка была», и производитель
# ответил бы про удаление ссылок там, где хук просто позвали руками.
if [ -n "$push_input" ]; then
    push_ranges="$(printf '%s\n' "$push_input" | bash "$ROOT/scripts/hooks/prepush-range.sh")"
else
    push_ranges="$(bash "$ROOT/scripts/hooks/prepush-range.sh" < /dev/null)"
fi
export KACHO_PUSH_RANGE="$push_ranges"

echo "== pre-push: локальные проверки перед отправкой «${push_remote_refs:-$announce_ref}» (копия на «$branch»)"
echo "   (обойти: git push --no-verify — но тогда конвейер станет первым читателем)"

# НАБОР ГРУПП ВЫВОДИТСЯ ИЗ СОСТАВА ИЗМЕНЕНИЙ отдельным производителем.
#
# Фиксированный «proto go» не знает, что тронута консоль, — и правка в
# `ui-future` уезжала в конвейер вообще без проверки. Дважды подряд это стоило
# круга: пробы консоли были зелёными на 5443 утверждениях, а строгая проверка
# типов роняла линт, typecheck и сборку семи модулей плюс образ консоли.
#
# Само вычисление живёт в scripts/hooks/prepush-groups.sh — оно ошибалось
# молча, пока было выражением внутри хука, и проверить его можно было только
# полной отправкой. Там же разобрано, почему база — точка ветвления от ствола,
# а не вышестоящая ветка.
groups="$(bash "$ROOT/scripts/hooks/prepush-groups.sh")"
echo "   группы прогона: $groups"
# Тот же диапазон, что у производителя групп: два разных ответа на один вопрос
# разошлись бы молча — и разошлись бы именно там, где расхождение не видно.
if [ -n "$push_ranges" ]; then
    changed=""
    for range in $push_ranges; do
        changed="$changed
$(git diff --name-only "$range" 2> /dev/null || true)"
    done
    echo "   уезжает: $(printf '%s' "$changed" | grep -c . ) файл(ов) в диапазоне(ах) $push_ranges"
else
    # Диапазона нет, когда вход был, но ни одной вершины не назвал. Отправка
    # одних удалений сюда уже не доходит: она вышла выше, до прогона (#2825).
    # Остаётся вход, в котором git не назвал ни одной отправляемой ссылки, — тогда
    # база берётся прежняя, той же, какой её возьмёт производитель групп: два
    # разных ответа на один вопрос разошлись бы молча.
    changed="$(git diff --name-only "${KACHO_TRUNK_REF:-origin/main}"...HEAD 2> /dev/null || true)"
    echo "   диапазона нет: вход не назвал ни одной вершины — судится рабочая копия"
fi

# ВЕРДИКТ ЧИТАЕТСЯ ПО ЧИСЛАМ, А НЕ ПО КОДУ ВОЗВРАТА.
#
# Прогонщик различает три исхода — исполнено, отказов, НЕ выполнено, — но кодом
# возврата отличает только второй. Пропуск («инструмент не установлен»,
# «зависимости не поставлены») кода не меняет, поэтому хук печатал «локальные
# проверки зелёные» при ОДИННАДЦАТИ невыполненных.
#
# Наблюдалось на правке гейта консоли: одиннадцать проверок консоли пропущены,
# потому что в свежей рабочей копии нет `node_modules`, — и та самая правка
# уехала объявленной зелёной, ни разу не проверенной. Третья категория исхода
# не вычитается из вердикта и не зачитывается в успех: это норма корпуса, а не
# придирка.
#
# Отказ — только когда пропущено то, что относится к ТРОНУТОМУ. Пропуск группы,
# к изменению отношения не имеющей, законен, но обязан быть НАЗВАН: иначе
# «зелено» означает меньше, чем читатель думает.
# ─────────────────────────────────────────────────────────────────────────────
# ВЕРДИКТ — О ДЕРЕВЕ, КОТОРОЕ УЕЗЖАЕТ, А НЕ О РАБОЧЕЙ КОПИИ
# ─────────────────────────────────────────────────────────────────────────────
#
# Прогон шёл в рабочей копии ВСЕГДА, а уезжает названный диапазон. Когда копия
# стоит на другой ревизии либо держит незакоммиченные правки отслеживаемых
# файлов, все проверки судят ЕЁ — и вердикт выносится о дереве, которого
# отправка не касается.
#
# Измерено, а не предположено (#2594): отправка ветки `bcc99ecebe` из копии,
# стоявшей на `18a38bfdb9`, была отвергнута гейтом объявленных разрывов
# контракта; числа отказа сошлись с рабочей копией (10 записей перечня), а не с
# отправляемым (8), и на отправляемом дереве гейт зелёный.
#
# СОВПАЛА копия с отправляемой вершиной и чиста — судим её на месте. Это
# подавляющее большинство отправок, и лишней работы они не получают. НЕ совпала —
# отправляемая ревизия раскладывается во временную рабочую копию, и прогон идёт
# в ней. Копия снимается в любом исходе: состояние, которое хук завёл, хук и
# убирает.
#
# Место временной копии — рядом с общим каталогом git, а не во временном
# разделе: раскладка дерева в tmpfs съедает индексные узлы и теряется при
# перезагрузке.
git_common="$(git rev-parse --git-common-dir 2> /dev/null || printf '%s' "$ROOT/.git")"
case "$git_common" in
    /*) : ;;
    *) git_common="$ROOT/$git_common" ;;
esac
# `$$` — идентификатор ЭТОГО процесса, и в подоболочке он тот же. Поэтому путь
# считается одинаково и внутри выбирающей функции, и снаружи, где стоит уборка:
# имя, возвращённое через подстановку команды, уборке не досталось бы — её
# присваивания остались бы в подоболочке.
#
# Имя ЛИСТА несёт идентификатор процесса, а не слово «tree», и это не косметика:
# git заводит запись о рабочей копии по имени листа, и лист с общим именем
# столкнулся бы с чужой копией. Уборка снимает ровно СВОЮ запись — общего
# `git worktree prune` здесь нет: он снял бы и чужие устаревшие записи, которых
# этот хук не заводил.
subject_tree_parent="$git_common/kacho-prepush-subject"
subject_tree_candidate="$subject_tree_parent/kacho-prepush-$$"

cleanup_subject_tree() {
    local record="$git_common/worktrees/kacho-prepush-$$"
    [ -e "$subject_tree_candidate" ] || [ -e "$record" ] || return 0
    git worktree remove --force "$subject_tree_candidate" > /dev/null 2>&1 || true
    rm -rf "$subject_tree_candidate" "$record" 2> /dev/null || true
    rmdir "$subject_tree_parent" 2> /dev/null || true
}
trap cleanup_subject_tree EXIT

# СБОРЩИК СВОИХ ОСТАТКОВ. Уборка по выходу не срабатывает на жёстком обрыве
# (`SIGKILL`, отключение питания): проверено — после него остаются и полная
# выкладка отправляемой ревизии, и запись о ней, а снять их некому. Ни следующая
# отправка, ни штатная чистка git их не видят.
#
# Собираются ТОЛЬКО свои: каталог с приставкой `kacho-prepush-`, в имени которого
# стоит идентификатор процесса. Чужие рабочие копии здесь не трогаются ни одной
# командой — общего `git worktree prune` нет намеренно: в этом клоне два десятка
# чужих копий, и часть их записей устарела не по нашей вине.
#
# Живой процесс с тем же идентификатором — не наш остаток, а чья-то идущая
# отправка: её выкладку не снимаем. Идентификаторы переиспользуются, поэтому
# вторым признаком идёт возраст: выкладка старше суток собирается независимо от
# того, занят ли её номер сейчас кем-то ещё.
reap_own_subject_trees() {
    local dir pid reaped=0
    [ -d "$subject_tree_parent" ] || return 0
    for dir in "$subject_tree_parent"/kacho-prepush-*; do
        [ -d "$dir" ] || continue
        pid="${dir##*/kacho-prepush-}"
        case "$pid" in '' | *[!0-9]*) continue ;; esac
        [ "$pid" = "$$" ] && continue
        if kill -0 "$pid" 2> /dev/null && [ -z "$(find "$dir" -maxdepth 0 -mtime +0 2> /dev/null)" ]; then
            continue
        fi
        git worktree remove --force "$dir" > /dev/null 2>&1 || true
        rm -rf "$dir" "$git_common/worktrees/kacho-prepush-$pid" 2> /dev/null || true
        reaped=$((reaped + 1))
    done
    rmdir "$subject_tree_parent" 2> /dev/null || true
    [ "$reaped" -eq 0 ] || echo "   собрано осиротевших выкладок прошлых отправок: $reaped" >&2
}
reap_own_subject_trees

push_tips_uniq="$(printf '%s' "$push_tips" | sed '/^$/d' | sort -u)"
push_tips_count="$(printf '%s' "$push_tips_uniq" | grep -c .)"

# Несколько РАЗНЫХ вершин в одной отправке: дерева, о котором был бы вердикт, у
# неё нет. Вердикт о произвольно выбранной был бы утверждением о дереве, которого
# отправка касается лишь отчасти, — то есть ровно тем, что этот блок и устраняет.
if [ "${push_tips_count:-0}" -gt 1 ]; then
    cat >&2 <<MSG

pre-push ОТКАЗ: отправка несёт $push_tips_count разных вершин ($push_remote_refs).

Одного дерева, о котором был бы вердикт, у неё нет: прогон судил бы одну из
вершин, а уехали бы все. Отправляйте ссылки по одной — либо явным черновиком
(git push --no-verify), зная, что конвейер станет первым читателем.
MSG
    exit 1
fi

# subject_tree_for_push — КОРЕНЬ ДЕРЕВА, О КОТОРОМ БУДЕТ ВЕРДИКТ.
#
# Печатает путь; пустой вывод означает «разложить отправляемую ревизию не
# удалось», и это ОТКАЗ, а не молчаливый возврат к рабочей копии: молчаливый
# возврат и есть предмет #2594.
subject_tree_for_push() {
    local tip head_commit dirty
    tip="$push_tips_uniq"
    # Вершины нет: вход пуст либо не назвал ни одного коммита — судится рабочая
    # копия КАК ЕСТЬ. Пуст вход в двух случаях: хук позван руками, и git позвал его
    # на отправке без изменений (вход тогда — ноль байт). Различить их хуку нечем:
    # вход один и тот же, а аргументы ручной вызов волен передать те же, что git.
    # Ручной вызов — законная форма прогона копии: производитель диапазона
    # отвечает на него той же базой, что настоящей отправке (ветвь пустого входа
    # в scripts/hooks/prepush-range.sh). Поэтому ответ у пустого входа — рабочая копия.
    # Выдавать её за отправляемую ревизию печать не вправе: вход её не назвал.
    # Отправка одних удалений сюда не доходит: она вышла до прогона (#2825).
    if [ -z "$tip" ]; then
        printf '%s' "$ROOT"
        return 0
    fi
    head_commit="$(git rev-parse --verify --quiet 'HEAD^{commit}' 2> /dev/null)"
    # ЧТО СЧИТАЕТСЯ РАСХОЖДЕНИЕМ — и почему не только правки отслеживаемых.
    #
    # Здесь стояло «неотслеживаемые не считаются: проверки читают состав дерева
    # через `git ls-files`». Довод неверен для большинства проверок: прогонщик
    # зовёт сборку, статический анализ и пробы, а они читают ФАЙЛОВУЮ СИСТЕМУ.
    # Лишний `.go` рядом компилируется здесь и отсутствует в отправляемой ревизии
    # — в одну сторону это ложное зелёное («забыл `git add` порождённый файл»,
    # самый частый случай), в другую — ложное красное.
    #
    # Поэтому расхождением считается и неотслеживаемое, НЕ ПОПАДАЮЩЕЕ под
    # игнор, — ровно то, что даёт `git status --porcelain` без ключей.
    #
    # Игнорируемое расхождением НЕ считается, и это выбор, а не недосмотр:
    # `node_modules`, кэши сборки и прочие порождённые артефакты — вход самого
    # прогонщика, а не часть контракта. Объявив их расхождением, мы сделали бы
    # временную выкладку обычным путём — а в ней этих артефактов нет, и проверки
    # консоли целиком уходили бы в «НЕ выполнено». Узкое ложное утверждение было
    # бы обменяно на широкое отсутствие вердикта.
    dirty="$(git status --porcelain 2> /dev/null | grep -c .)"
    if [ "$tip" = "$head_commit" ] && [ "${dirty:-0}" -eq 0 ]; then
        printf '%s' "$ROOT"
        return 0
    fi
    mkdir -p "$subject_tree_parent" 2> /dev/null || return 1
    git worktree add --detach --quiet "$subject_tree_candidate" "$tip" > /dev/null 2>&1 || return 1
    printf '%s' "$subject_tree_candidate"
}

subject_root="$(subject_tree_for_push)"
if [ -z "$subject_root" ]; then
    cat >&2 <<MSG

pre-push ОТКАЗ: рабочая копия не равна отправляемой ревизии, а разложить
отправляемое дерево во временную копию не удалось.

Прогон в рабочей копии вынес бы вердикт о ДРУГОМ дереве — том, которого эта
отправка не касается. Такой вердикт хуже отсутствия: он выглядит как ответ.

Приведите копию к отправляемой ревизии (git checkout / git stash) либо
отправьте черновик явно — git push --no-verify.
MSG
    exit 1
fi
if [ -z "$push_tips_uniq" ]; then
    echo "   вердикт — о рабочей копии как есть: вход git не назвал ни одной вершины, отправляемой ревизии хук не видел"
elif [ "$subject_root" = "$ROOT" ]; then
    echo "   вердикт — о рабочей копии: она и есть отправляемая ревизия"
else
    echo "   вердикт — об ОТПРАВЛЯЕМОЙ ревизии $(printf '%s' "$push_tips_uniq" | cut -c1-8): рабочая копия ей не равна,"
    echo "   прогон идёт во временной копии этой ревизии"
fi

run_out="$(bash "$subject_root/scripts/ci-local.sh" $groups 2>&1)"
run_rc=$?
printf '%s\n' "$run_out"

skipped="$(printf '%s' "$run_out" | sed -n 's/.*НЕ выполнено \([0-9]*\).*/\1/p' | tail -1)"
if [ "${skipped:-0}" -gt 0 ] && [ "$run_rc" -eq 0 ]; then
    printf '\npre-push: проверок НЕ ВЫПОЛНЕНО — %s. Это не «зелено».\n' "$skipped" >&2
    printf '%s\n' "$run_out" | grep 'ПРОПУСК' | sort -u | sed 's/^/  /' >&2
    case "$changed" in
        *ui-future/*)
            # Сравнение БЕЗ трубы: `grep -q` выходит до конца входа, писатель
            # получает SIGPIPE, а `pipefail` поднимает это до статуса конвейера —
            # найденное объявляется ненайденным (#658). Здесь это было бы особенно
            # тихо: ложное «не найдено» означает «пропуска нет», то есть отправку
            # без вердикта — ровно то, что этот блок и обязан остановить.
            if [[ "$run_out" == *"ПРОПУСК"*"зависимости не установлены"* ]]; then
                cat >&2 <<'MSG'

pre-push ОТКАЗ: изменение трогает консоль, а её проверки НЕ ВЫПОЛНЯЛИСЬ.
Вердикта по ним нет ни одного — отправлять нечего подтверждать.
Почините условие: npm ci --prefix <пакет> — либо отправьте черновик явно
(git push --no-verify), зная, что конвейер станет первым читателем.
MSG
                exit 1
            fi
            ;;
    esac
    printf '  (к тронутому не относится — отправляю, но вердикт УЖЕ этого перечня)\n' >&2
fi

# КОД 3 — НЕСОСТОЯВШИЙСЯ ПРОГОН, А НЕ КРАСНОЕ (#862).
#
# Прогонщик отличает шаг, оборванный исчерпанием ресурса, от шага, упавшего по
# существу, и говорит об этом отдельным кодом. Без этой ветки хук печатал бы
# «почините найденное» там, где находок НЕТ НИ ОДНОЙ, — то есть ровно ту
# неверную подсказку оператору, которую задача называет сопутствующей.
#
# Отправка останавливается всё равно: вердикта нет, и подтверждать нечего.
# Разница не в исходе, а в том, куда пойдёт читатель.
if [ "$run_rc" -eq 3 ]; then
    cat >&2 <<'MSG'

pre-push ОТКАЗ: локальный прогон НЕДЕЙСТВИТЕЛЕН — отправка остановлена.

Ресурс кончился прямо в прогоне (место на диске либо память), и шаг оборвался,
не дойдя до предмета. Вердикта нет ни у одного шага, включая прошедшие: здесь
«находок нет» означает «не смотрели».

В дереве чинить нечего. Освободите ресурс и повторите прогон целиком:
  df -h /                  # место
  go clean -cache          # кэш сборки Go отрастает за часы
  docker builder prune -f  # кэш образов — тоже
Либо отправьте черновик явно (git push --no-verify), зная, что конвейер станет
первым читателем.
MSG
    exit 1
fi

if [ "$run_rc" -ne 0 ]; then
    cat >&2 <<'MSG'

pre-push ОТКАЗ: локальные проверки красные — отправка остановлена.

Это не придирка хука: ровно эти проверки сейчас упадут в конвейере, только там
ответ придёт через двадцать минут и займёт ранер, которого не хватает.

Три исхода, четвёртого нет:
  почините найденное;
  объявите слом там, где он объявляется (proto/declared-breaks.yaml);
  отправьте черновик явно — git push --no-verify.
MSG
    exit 1
fi

# ЧТО ЭТА ОТПРАВКА СНИМЕТ — говорится вслух, до того как снимет.
#
# В каждом потоке стоит группа конкуренции по ветке с отменой идущего: сделано
# намеренно, чтобы очередь не росла. Цена в другом — при частой отправке вердикта
# не остаётся НИ У ОДНОЙ ревизии. Замер 2026-08-17: три отправки за двадцать пять
# минут сняли пять прогонов, включая проверку консоли на САМОЙ СВЕЖЕЙ ревизии,
# и по ней вердикта не было вовсе, пока прогон не перезапустили руками.
#
# ЭТО ПРЕДУПРЕЖДЕНИЕ, А НЕ ЗАПРЕТ. Отменять идущий прогон бывает правильно (он
# уже неактуален), а иногда — единственный способ починить красное быстро.
# Решает человек; хук лишь не даёт снять вердикт НЕЗАМЕТНО.
#
# Сеть здесь не обязательна: без `gh`, без сети и по таймауту хук молчит и ничего
# не роняет. Предмет хука — код, а не доступность GitHub.
announce_runs_this_push_will_cancel() {
    command -v gh > /dev/null || return 0
    local running
    running="$(timeout 6 gh run list --branch "$announce_ref" --status in_progress \
        --limit 10 --json workflowName,headSha \
        -q '.[]|"   • \(.workflowName) на \(.headSha[0:8])"' 2> /dev/null)" || return 0
    [ -n "$running" ] || return 0
    cat >&2 <<MSG

pre-push: эта отправка СНИМЕТ идущие прогоны — вердикта по ним не будет:
$running
   (так устроена группа конкуренции: один живой прогон на ветку. Если вердикт
    нужен, дождитесь его; если нет — отправляйте, это законно.)
MSG
}

announce_runs_this_push_will_cancel

# Постусловие отправки — функция определена рядом со входом, там же и довод.
postcondition_note

# Вердикт называет ОБЛАСТЬ зелёного, а не только его цвет: «зелёные» без числа
# невыполненных читается шире, чем есть, — и читалось.
if [ "${skipped:-0}" -gt 0 ]; then
    echo "== pre-push: отказов нет, но НЕ выполнено ${skipped} — отправляю с этой оговоркой"
else
    echo "== pre-push: локальные проверки зелёные (не выполненных нет) — отправляю"
fi
