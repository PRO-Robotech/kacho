#!/usr/bin/env bash
# Copyright (c) PRO-Robotech
# SPDX-License-Identifier: BUSL-1.1
#
# Хук отправки: то, что можно узнать локально, узнаётся ДО конвейера.
#
# ЗАЧЕМ ХУК, А НЕ ПУНКТ В РЕГЛАМЕНТЕ. Правило «прогоняй локально» существовало и
# соблюдалось ровно до первой спешки: конвейер оказывался первым читателем кода и
# отвечал через двадцать минут. Обещание держится гейтом, а не памятью.
#
# ЧТО ГОНЯЕТСЯ. Быстрые группы: генерация и совместимость контракта, сборка,
# статический анализ, короткие пробы, линтеры, gosec — в ТОЙ ЖЕ форме, что в
# конвейере. Медленное (кластер, сквозные прогоны, интеграция с контейнерами)
# здесь НЕ гоняется и названо в выводе прогонщика прямо.
#
# КАК ОБОЙТИ И ПОЧЕМУ ЭТО ЗАКОННО. `git push --no-verify` либо
# `KACHO_SKIP_PREPUSH=1`. Обход нужен: отправка ветки-черновика ради обсуждения —
# законное действие. Но он ЯВНЫЙ: обойти можно, не заметив — нельзя.
#
# Установка: `make install-hooks` — цель кладёт в `.git/hooks` переходник,
# исполняющий ЭТОТ файл из той рабочей копии, из которой идёт отправка.
# Проверить провязку в любой момент: `make check-hooks`.
#
# `git config core.hooksPath scripts/hooks` здесь НЕ советуется, хотя и работает:
# он перебивает `.git/hooks` целиком, и всё, что там уже лежало, перестаёт
# исполняться молча. Разбор — в шапке scripts/hooks/install.sh.
set -uo pipefail

if [ "${KACHO_SKIP_PREPUSH:-0}" = "1" ]; then
    echo "pre-push: пропущен по KACHO_SKIP_PREPUSH=1 — локальные проверки НЕ выполнялись" >&2
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"

# ОКРУЖЕНИЕ GIT НЕ НАСЛЕДУЕТСЯ ПРОВЕРКАМИ. `git push` запускает хук с
# выставленным `GIT_DIR` (а при иных вызовах — и `GIT_WORK_TREE`/`GIT_INDEX_FILE`),
# и дальше его наследует ВСЁ, что хук запускает, — в том числе `go test`.
#
# Цена наследования измерена, а не предположена. В дереве полтора десятка проб
# заводят синтетический репозиторий во временном каталоге (`git init` + `git add
# -A`), задавая рабочий каталог команды и полагаясь на то, что git определит
# репозиторий по нему. С выставленным `GIT_DIR` git его НЕ определяет: переменная
# сильнее рабочего каталога — и `add -A` фикстуры пишет в индекс ЭТОЙ рабочей
# копии. Индекс схлопывается до нескольких записей фикстуры.
#
# Дальше ложь расходится кругами: гейты, читающие состав дерева через `git
# ls-files` (`pkg/treecorpus`), видят пустой индекс и честно падают с
# «прочитано ноль» — то есть отказ получают проверки, ни к чему не причастные,
# а виновник остаётся невидимым. Замер на этом дереве: те же пакеты без
# `GIT_DIR` — индекс цел (6994 записи), падений 0; с `GIT_DIR` — индекс 3
# записи, падений 119.
#
# Поэтому хук — граница, на которой окружение обрывается. В конвейере класс не
# воспроизводится by construction: там проверки запускает не git, поэтому
# «зелёный конвейер» его никогда бы и не показал.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX

# Ветка, которую никто не собирается вливать, проверок не требует: предмет хука —
# то, что поедет в запрос на слияние. Определяем по имени: всё, кроме личных
# черновиков `wip/` и `tmp/`.
branch="$(git rev-parse --abbrev-ref HEAD)"
case "$branch" in
    wip/*|tmp/*)
        echo "pre-push: ветка «$branch» объявлена черновиком — проверки пропущены" >&2
        exit 0
        ;;
esac

# ЧТО ИМЕННО УЕЗЖАЕТ — СПРАШИВАЕМ У GIT, А НЕ ВЫВОДИМ ИЗ ИМЕНИ ВЕТКИ.
#
# git передаёт хуку на вход строки `<local_ref> <local_sha> <remote_ref>
# <remote_sha>` — по одной на каждую отправляемую ссылку. Это авторитетный
# ответ на вопрос «что уедет этой отправкой»; ни точка ветвления, ни
# вышестоящая ветка его не заменяют.
#
# САМО ПОСТРОЕНИЕ ДИАПАЗОНА — отдельным производителем
# (scripts/hooks/prepush-range.sh), по той же причине, по которой отдельно
# живёт набор групп: это РЕШЕНИЕ, оно ошибалось молча, и проверить его
# выражением внутри хука можно было только полной отправкой.
#
# Ошибалось оно так (#805): у ПЕРВОЙ отправки ссылки на origin ещё нет,
# базу приходится выбирать, и здесь стояло «ствол». Для ветки, отведённой от
# накопительной релизной линии, трёхточечный диапазон от ствола вбирает ВСЮ
# работу линии — и хук требовал проверок консоли у ветки, не тронувшей её ни
# одним файлом. Разбор выбора базы — в шапке производителя.
push_ranges="$(bash "$ROOT/scripts/hooks/prepush-range.sh")"
export KACHO_PUSH_RANGE="$push_ranges"

echo "== pre-push: локальные проверки перед отправкой ветки «$branch»"
echo "   (обойти: git push --no-verify — но тогда конвейер станет первым читателем)"

# НАБОР ГРУПП ВЫВОДИТСЯ ИЗ СОСТАВА ИЗМЕНЕНИЙ отдельным производителем.
#
# Фиксированный «proto go» не знает, что тронута консоль, — и правка в
# `ui-future` уезжала в конвейер вообще без проверки. Дважды подряд это стоило
# круга: пробы консоли были зелёными на 5443 утверждениях, а строгая проверка
# типов роняла линт, typecheck и сборку семи модулей плюс образ консоли.
#
# Само вычисление живёт в scripts/hooks/prepush-groups.sh — оно ошибалось
# молча, пока было выражением внутри хука, и проверить его можно было только
# полной отправкой. Там же разобрано, почему база — точка ветвления от ствола,
# а не вышестоящая ветка.
groups="$(bash "$ROOT/scripts/hooks/prepush-groups.sh")"
echo "   группы прогона: $groups"
# Тот же диапазон, что у производителя групп: два разных ответа на один вопрос
# разошлись бы молча — и разошлись бы именно там, где расхождение не видно.
if [ -n "$push_ranges" ]; then
    changed=""
    for range in $push_ranges; do
        changed="$changed
$(git diff --name-only "$range" 2> /dev/null || true)"
    done
    echo "   уезжает: $(printf '%s' "$changed" | grep -c . ) файл(ов) в диапазоне(ах) $push_ranges"
else
    # Диапазона нет только в одном случае: отправка несёт лишь УДАЛЕНИЕ ссылок
    # (вход хука был, но во всех строках нулевой `<local_sha>`). Проверять там
    # нечего, и база берётся прежняя — той же, какой её возьмёт производитель
    # групп: два разных ответа на один вопрос разошлись бы молча.
    changed="$(git diff --name-only "${KACHO_TRUNK_REF:-origin/main}"...HEAD 2> /dev/null || true)"
    echo "   уезжает только удаление ссылок — диапазона нет"
fi

# ВЕРДИКТ ЧИТАЕТСЯ ПО ЧИСЛАМ, А НЕ ПО КОДУ ВОЗВРАТА.
#
# Прогонщик различает три исхода — исполнено, отказов, НЕ выполнено, — но кодом
# возврата отличает только второй. Пропуск («инструмент не установлен»,
# «зависимости не поставлены») кода не меняет, поэтому хук печатал «локальные
# проверки зелёные» при ОДИННАДЦАТИ невыполненных.
#
# Наблюдалось на правке гейта консоли: одиннадцать проверок консоли пропущены,
# потому что в свежей рабочей копии нет `node_modules`, — и та самая правка
# уехала объявленной зелёной, ни разу не проверенной. Третья категория исхода
# не вычитается из вердикта и не зачитывается в успех: это норма корпуса, а не
# придирка.
#
# Отказ — только когда пропущено то, что относится к ТРОНУТОМУ. Пропуск группы,
# к изменению отношения не имеющей, законен, но обязан быть НАЗВАН: иначе
# «зелено» означает меньше, чем читатель думает.
run_out="$(bash "$ROOT/scripts/ci-local.sh" $groups 2>&1)"
run_rc=$?
printf '%s\n' "$run_out"

skipped="$(printf '%s' "$run_out" | sed -n 's/.*НЕ выполнено \([0-9]*\).*/\1/p' | tail -1)"
if [ "${skipped:-0}" -gt 0 ] && [ "$run_rc" -eq 0 ]; then
    printf '\npre-push: проверок НЕ ВЫПОЛНЕНО — %s. Это не «зелено».\n' "$skipped" >&2
    printf '%s\n' "$run_out" | grep 'ПРОПУСК' | sort -u | sed 's/^/  /' >&2
    case "$changed" in
        *ui-future/*)
            # Сравнение БЕЗ трубы: `grep -q` выходит до конца входа, писатель
            # получает SIGPIPE, а `pipefail` поднимает это до статуса конвейера —
            # найденное объявляется ненайденным (#658). Здесь это было бы особенно
            # тихо: ложное «не найдено» означает «пропуска нет», то есть отправку
            # без вердикта — ровно то, что этот блок и обязан остановить.
            if [[ "$run_out" == *"ПРОПУСК"*"зависимости не установлены"* ]]; then
                cat >&2 <<'MSG'

pre-push ОТКАЗ: изменение трогает консоль, а её проверки НЕ ВЫПОЛНЯЛИСЬ.
Вердикта по ним нет ни одного — отправлять нечего подтверждать.
Почините условие: npm ci --prefix <пакет> — либо отправьте черновик явно
(git push --no-verify), зная, что конвейер станет первым читателем.
MSG
                exit 1
            fi
            ;;
    esac
    printf '  (к тронутому не относится — отправляю, но вердикт УЖЕ этого перечня)\n' >&2
fi

# КОД 3 — НЕСОСТОЯВШИЙСЯ ПРОГОН, А НЕ КРАСНОЕ (#862).
#
# Прогонщик отличает шаг, оборванный исчерпанием ресурса, от шага, упавшего по
# существу, и говорит об этом отдельным кодом. Без этой ветки хук печатал бы
# «почините найденное» там, где находок НЕТ НИ ОДНОЙ, — то есть ровно ту
# неверную подсказку оператору, которую задача называет сопутствующей.
#
# Отправка останавливается всё равно: вердикта нет, и подтверждать нечего.
# Разница не в исходе, а в том, куда пойдёт читатель.
if [ "$run_rc" -eq 3 ]; then
    cat >&2 <<'MSG'

pre-push ОТКАЗ: локальный прогон НЕДЕЙСТВИТЕЛЕН — отправка остановлена.

Ресурс кончился прямо в прогоне (место на диске либо память), и шаг оборвался,
не дойдя до предмета. Вердикта нет ни у одного шага, включая прошедшие: здесь
«находок нет» означает «не смотрели».

В дереве чинить нечего. Освободите ресурс и повторите прогон целиком:
  df -h /                  # место
  go clean -cache          # кэш сборки Go отрастает за часы
  docker builder prune -f  # кэш образов — тоже
Либо отправьте черновик явно (git push --no-verify), зная, что конвейер станет
первым читателем.
MSG
    exit 1
fi

if [ "$run_rc" -ne 0 ]; then
    cat >&2 <<'MSG'

pre-push ОТКАЗ: локальные проверки красные — отправка остановлена.

Это не придирка хука: ровно эти проверки сейчас упадут в конвейере, только там
ответ придёт через двадцать минут и займёт ранер, которого не хватает.

Три исхода, четвёртого нет:
  почините найденное;
  объявите слом там, где он объявляется (proto/declared-breaks.yaml);
  отправьте черновик явно — git push --no-verify.
MSG
    exit 1
fi

# ЧТО ЭТА ОТПРАВКА СНИМЕТ — говорится вслух, до того как снимет.
#
# В каждом потоке стоит группа конкуренции по ветке с отменой идущего: сделано
# намеренно, чтобы очередь не росла. Цена в другом — при частой отправке вердикта
# не остаётся НИ У ОДНОЙ ревизии. Замер 2026-08-17: три отправки за двадцать пять
# минут сняли пять прогонов, включая проверку консоли на САМОЙ СВЕЖЕЙ ревизии,
# и по ней вердикта не было вовсе, пока прогон не перезапустили руками.
#
# ЭТО ПРЕДУПРЕЖДЕНИЕ, А НЕ ЗАПРЕТ. Отменять идущий прогон бывает правильно (он
# уже неактуален), а иногда — единственный способ починить красное быстро.
# Решает человек; хук лишь не даёт снять вердикт НЕЗАМЕТНО.
#
# Сеть здесь не обязательна: без `gh`, без сети и по таймауту хук молчит и ничего
# не роняет. Предмет хука — код, а не доступность GitHub.
announce_runs_this_push_will_cancel() {
    command -v gh > /dev/null || return 0
    local running
    running="$(timeout 6 gh run list --branch "$branch" --status in_progress \
        --limit 10 --json workflowName,headSha \
        -q '.[]|"   • \(.workflowName) на \(.headSha[0:8])"' 2> /dev/null)" || return 0
    [ -n "$running" ] || return 0
    cat >&2 <<MSG

pre-push: эта отправка СНИМЕТ идущие прогоны — вердикта по ним не будет:
$running
   (так устроена группа конкуренции: один живой прогон на ветку. Если вердикт
    нужен, дождитесь его; если нет — отправляйте, это законно.)
MSG
}

announce_runs_this_push_will_cancel

# Вердикт называет ОБЛАСТЬ зелёного, а не только его цвет: «зелёные» без числа
# невыполненных читается шире, чем есть, — и читалось.
if [ "${skipped:-0}" -gt 0 ]; then
    echo "== pre-push: отказов нет, но НЕ выполнено ${skipped} — отправляю с этой оговоркой"
else
    echo "== pre-push: локальные проверки зелёные (не выполненных нет) — отправляю"
fi
