{{/*
umbrella.trustDomain — ДОМЕН ДОВЕРИЯ установки для личностей, которые чеканит
сам зонтичный чарт (служебная учётка первичной настройки).

Объявление ОДНО на чарт по той же причине, по какой оно одно у каждого
компонента: домен читают выпускающая сторона и принимающая, и взятый по
отдельности он расходится МОЛЧА — сертификат настоящий, а принимающий его
домена не знает.

Читается из раздела личности той учётки, для которой чеканится сертификат:
у зонтичного чарта своего SPIFFE-раздела нет, а у учётки — есть.
*/}}
{{- define "umbrella.trustDomain" -}}
{{- $op := (.Values.mtls | default dict).bootstrapOperator | default dict -}}
{{- $sp := $op.spiffe | default dict -}}
{{- $sp.trustDomain | default "kacho.cloud" -}}
{{- end -}}
