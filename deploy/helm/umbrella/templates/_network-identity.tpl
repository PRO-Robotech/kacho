{{/*
МЕТКИ ПОДОВ, которыми политики сети умбреллы называют цель и отправителя.

Метку пода ставит чарт компонента, а политику пишет умбрелла. Пока политика
выписывала метку по памяти, они расходились МОЛЧА: правило, назвавшее метку,
которой под не несёт, не пропускает никого, и служба остаётся недостижимой при
зелёных рендере, установке и готовности (kacho#2941). Поэтому метка выводится
здесь из того же источника, из которого её получает под.

umbrella.edgeSelectorLabels — метки пода КРАЯ. Определение одно и живёт в чарте
края (`api-gateway.selectorLabels`): его же зовут селектор рабочего объекта края,
шаблон его пода и его Service. Сюда передаются значения чарта края, а не умбреллы.
*/}}
{{- define "umbrella.edgeSelectorLabels" -}}
{{- include "api-gateway.selectorLabels" (dict "Values" (index .Values "api-gateway")) -}}
{{- end -}}

{{/*
umbrella.appSelectorLabels — метка пода СЛУЖБЫ по имени её подчарта.

Вход — (dict "root" $ "chart" "<подчарт>"). Чарты служб (vpc, compute,
kacho-nlb) метят под `app: <name>` из собственного значения `name`, и здесь
читается ровно это значение, со всеми умолчаниями подчарта. Пустое имя — отказ
рендера: селектор `app: ""` не выбрал бы ни одного пода.
*/}}
{{- define "umbrella.appSelectorLabels" -}}
{{- $vals := index .root.Values .chart | default dict -}}
app: {{ required (printf "%s.name обязателен: из него выводится метка пода, которую называют политики сети" .chart) $vals.name }}
{{- end -}}
