{{/*
Copyright (c) PRO-Robotech
SPDX-License-Identifier: BUSL-1.1

СОСЕД-ТЕРМИНАТОР административного перехода: конфигурация и спецификация в ОДНОМ
месте, формирующие значения — в одном объявлении.

═══════════════════════════════════════════════════════════════════════════════
ПОЧЕМУ ЭТО ЗДЕСЬ, А НЕ В ЗНАЧЕНИЯХ ПРОФИЛЕЙ

Настройки соседа приезжают в под ТОМОМ, и ни одна аннотация шаблона пода их не
хэширует. Добавить такую аннотацию через значения чарта провайдера НЕЛЬЗЯ: через
шаблонизацию (`tpl`) у него проходит ТОЛЬКО список дополнительных контейнеров —
`deployment.annotations` и `podMetadata.annotations` идут прямым `toYaml` и
вычислить в них sha256 не из чего.

Следствие без этого файла: правка настроек соседа даёт успешное обновление, новый
объект настроек и ПОБАЙТОВО ТОТ ЖЕ шаблон пода → переката нет → nginx читает
конфигурацию один раз при старте и больше никогда → ЖИВОЙ терминатор остаётся со
старой. Любой гейт, читающий рендер, при этом отчитается новым значением.

Поэтому отпечаток конфигурации живёт в спецификации САМОГО СОСЕДА (переменная
окружения ниже): она через шаблонизацию проходит, значит шаблон пода меняется ПО
ПОСТРОЕНИЮ при любой правке конфигурации — включая правку её текста, а не только
чисел. Гейт deploy/tests/helm/admin-hop-pod-shape-test.sh СВЕРЯЕТ отпечаток с
sha256 сохранённого содержимого, поэтому привязка доказана, а не заявлена.

РЕЗЧЕ — РАССИНХРОН ПОРТОВ. Номер листенера провайдера и порт, на который сосед
проксирует, обязаны быть ОДНИМ числом; порт соседа в поде, в его конфигурации, в
пробах и в Service — тоже одним. До этого файла каждое из них было отдельным
литералом в двух профилях: смена одного не перекатывала под, дерево и работающая
система расходились МОЛЧА — до следующего несвязанного рестарта, который уносит
конечные точки обоих сервисов. Здесь число объявлено ОДИН РАЗ
(`global.kacho.hydraAdminTls`), и оба контекста читают его оттуда.

ПОЧЕМУ ИМЕННО `global`. Именованный шаблон вызывается из ДВУХ контекстов: из
шаблонов умбреллы (объект настроек, Service) и из строки `extraContainers`,
которую разворачивает `tpl` уже в контексте САБЧАРТА провайдера. Там `.Values` —
значения сабчарта, и `.Values.mtls` не существует. Общими для обоих контекстов
являются `.Values.global` и `.Release` — только они здесь и читаются, иначе
отпечаток считался бы над одним текстом, а в объект настроек уезжал бы другой.
*/}}

{{/* Формирующие значения — единственное объявление, читаемое из обоих контекстов. */}}
{{- define "kacho.hydraAdminTls.settings" -}}
{{- $g := .Values.global | default dict -}}
{{- $k := $g.kacho | default dict -}}
{{- $s := $k.hydraAdminTls | default dict -}}
{{- dict
      "terminatorPort"       ($s.terminatorPort       | default 4445)
      "providerListenerPort" ($s.providerListenerPort | default 4455)
      "upstreamTimeout"      ($s.upstreamTimeout      | default "30s")
      "image"                ($s.image                | default "nginxinc/nginx-unprivileged:1.31-alpine")
      "preStopSeconds"       ($s.preStopSeconds       | default 5)
    | toYaml -}}
{{- end -}}

{{/*
Конфигурация nginx. Ни одного значения из контекста, кроме перечисленных выше, —
см. шапку про два контекста.
*/}}
{{- define "kacho.hydraAdminTls.conf" -}}
{{- $s := fromYaml (include "kacho.hydraAdminTls.settings" .) -}}
# ЖУРНАЛ — СЕРВЕРНАЯ ПОЛОВИНА СВИДЕТЕЛЬСТВА О ШИФРОВАНИИ.
#
# О том, что соединение шифровано, сообщает ДАЛЬНИЙ КОНЕЦ, и сообщение
# производит транспортный стек, а не значение в настройках. Сторона под
# оценкой (iam, шлюз) в этом ответе не участвует. Тот же приём, что
# pg_stat_ssl в секции B гейта посадки.
#
# Поля обязательны все, и КАЖДОЕ ЧИТАЕТСЯ гейтом: протокол и шифр заполняет
# TLS-стек; статус и ВРЕМЯ апстрима доказывают, что ответ произвёл ПРОВАЙДЕР,
# а не сам сосед (у ответа, не касавшегося апстрима, оба поля — прочерк, и
# живой гейт на этом краснеет); маркер позволяет найти запись ИМЕННО СВОЕЙ
# пробы, а не «какую-нибудь».
log_format kacho_admin_tls
  '$request_id ssl_protocol=$ssl_protocol ssl_cipher=$ssl_cipher '
  'upstream_status=$upstream_status upstream_time=$upstream_response_time '
  'status=$status method=$request_method marker=$http_x_kacho_probe';

server {
  # ЕДИНСТВЕННЫЙ ЛИСТЕНЕР, И ОН TLS. Плейнтекстового у соседа нет НИ ОДНОГО:
  # конфигурации без TLS не существует, поэтому тихого отката на открытый
  # текст при невыданном сертификате быть не может — сосед просто не станет
  # готовым, и под вместе с ним.
  listen {{ $s.terminatorPort }} ssl;
  http2 on;
  server_name _;

  ssl_certificate     /etc/tls/tls.crt;
  ssl_certificate_key /etc/tls/tls.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:admin_tls:1m;
  ssl_session_timeout 10m;

  access_log /dev/stdout kacho_admin_tls;
  error_log  /dev/stderr warn;

  # ПОВЕРХНОСТЬ НЕ СУЖАЕТСЯ: полный проброс, а не список разрешённых путей.
  # Терминатор решает ТРАНСПОРТ, а не авторизацию. Неполный список ломал бы
  # поток потребителя МОЛЧА — а авторизации на этом API нет by design, её
  # введение самостоятельная работа.
  #
  # СТАТИЧЕСКОГО ПУТИ ЗДОРОВЬЯ ЗДЕСЬ НЕТ НАМЕРЕННО. В образце, с которого
  # списан приём, путь здоровья возвращал константу, не зависящую от
  # апстрима. Скопировать это значило бы получить «под готов» при повисшем
  # провайдере И ПОТЕРЯТЬ его собственный сигнал готовности: пробы пода
  # направлены сюда. Поэтому всё, включая /health/*, уходит на апстрим —
  # и готовность краснеет в ОБЕ стороны: мёртв сосед (соединение не
  # установится) ИЛИ не отвечает провайдер (апстрим молчит).
  #
  # ЭТО ЗАПРЕТ, А НЕ ПОЖЕЛАНИЕ, И ОН ИСПОЛНЯЕТСЯ ДВУМЯ ГЕЙТАМИ:
  # admin-hop-pod-shape-test.sh краснеет на любом location'е со статическим
  # ответом ещё до развёртывания, а живой assert-admin-hop-transport.sh — на
  # прочерке в полях апстрима. Комментарий сам по себе не краснеет.
  location / {
    # АПСТРИМ — ПЕТЛЯ ЭТОГО ЖЕ ПОДА. Снаружи пода до листенера провайдера
    # не дотянуться по построению.
    proxy_pass http://127.0.0.1:{{ $s.providerListenerPort }};

    # 1.0 (умолчание proxy_pass) ломает POST интроспекции — а он на пути
    # КАЖДОГО промаха кэша.
    proxy_http_version 1.1;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    # БЕЗ ЭТОГО ЗАГОЛОВКА провайдер боевого класса (без отладочного флага)
    # отвергнет плейнтекст даже от разрешённого источника терминации.
    proxy_set_header X-Forwarded-Proto https;

    # БЮДЖЕТ ЗАПРОСА ПРИНАДЛЕЖИТ ВЛАДЕЛЬЦУ ЗАПРОСА, А НЕ ПОСРЕДНИКУ.
    # Значение НЕ КОРОЧЕ самого длинного per-call дедлайна потребителя;
    # иначе истечение срока определял бы этот файл, и потребитель получал бы
    # обрыв раньше, чем сам решил сдаться.
    proxy_connect_timeout 5s;
    proxy_send_timeout    {{ $s.upstreamTimeout }};
    proxy_read_timeout    {{ $s.upstreamTimeout }};
  }
}
{{- end -}}

{{/*
Спецификация соседа. Разворачивается `tpl`-ом чарта провайдера из
`hydra.deployment.extraContainers` — то есть в контексте САБЧАРТА.
*/}}
{{- define "kacho.hydraAdminTls.sidecar" -}}
{{- $s := fromYaml (include "kacho.hydraAdminTls.settings" .) -}}
- name: admin-tls
  image: {{ $s.image | quote }}
  imagePullPolicy: IfNotPresent
  ports:
    - name: https-admin
      containerPort: {{ $s.terminatorPort }}
      protocol: TCP
  env:
    # ОТПЕЧАТОК КОНФИГУРАЦИИ — ПРИВЯЗКА СОДЕРЖИМОГО К ШАБЛОНУ ПОДА.
    # Не «переменная для процесса»: nginx её не читает и читать не должен. Она
    # существует затем, чтобы ЛЮБАЯ правка конфигурации меняла шаблон пода и
    # под перекатывался — единственное доступное здесь место, поскольку
    # аннотации шаблона пода через значения чарта провайдера не вычисляются.
    # Гейт формы пода сверяет это значение с sha256 сохранённого содержимого.
    - name: KACHO_ADMIN_TLS_CONF_SHA256
      value: {{ include "kacho.hydraAdminTls.conf" . | sha256sum | quote }}
  # ПРОБА ЖИВОСТИ — САМОЛЕЧЕНИЕ ЗАВИСШЕГО ПОСРЕДНИКА. Упавший процесс kubelet
  # перезапустит и без неё; ЗАВИСШИЙ — нет, и под остаётся неготовым бессрочно,
  # унося конечные точки ОБОИХ сервисов (интроспекция шлюза и всё, что iam
  # регистрирует).
  #
  # ПРОВЕРЯЕТСЯ ПРИЁМ СОЕДИНЕНИЙ, А НЕ ВЕСЬ ПЕРЕХОД, И ЭТО ОСОЗНАННО. Проба по
  # HTTP ушла бы на апстрим (статического пути у соседа нет намеренно) — тогда
  # повисший ПРОВАЙДЕР перезапускал бы СОСЕДА, сцепление в ту сторону, в
  # которую его не хотели. Здоровье всего перехода — предмет ГОТОВНОСТИ, и
  # ответ на него не «перезапустить», а «убрать из конечных точек».
  livenessProbe:
    tcpSocket:
      port: {{ $s.terminatorPort }}
    periodSeconds: 10
    timeoutSeconds: 3
    failureThreshold: 3
  # ОКНО НА ОСТАНОВКУ. При удалении пода сигнал приходит контейнерам сразу, а
  # снятие конечных точек идёт асинхронно: без этой паузы на хвосте КАЖДОГО
  # переката запросы ещё приезжают в умирающий под. Для проверки отзыва токена
  # это тихий непроход — её отказ классифицируется как временный.
  lifecycle:
    preStop:
      exec:
        command: ["/bin/sleep", "{{ $s.preStopSeconds }}"]
  securityContext:
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    runAsNonRoot: true
    runAsUser: 65534
    capabilities:
      drop: ["ALL"]
    seccompProfile:
      type: RuntimeDefault
  volumeMounts:
    - name: hydra-admin-tls
      mountPath: /etc/tls
      readOnly: true
    - name: hydra-admin-tls-conf
      mountPath: /etc/nginx/conf.d
      readOnly: true
    - name: hydra-admin-tls-run
      mountPath: /tmp
    - name: hydra-admin-tls-cache
      mountPath: /var/cache/nginx
  # ПОТОЛКА ПРОЦЕССОРА ЗДЕСЬ НЕТ, И ЭТО НЕ УПУЩЕНИЕ. Посредник встал ВНУТРЬ
  # бюджета чужого запроса: на КАЖДОМ промахе кэша интроспекции через него идёт
  # живой предъявитель. Потолок превращает всплеск нагрузки в ЗАДЕРЖКУ (cgroup
  # троттлит, а не отказывает), а отказ интроспекции у потребителя
  # классифицируется как временный — то есть проверка отзыва тихо перестаёт
  # исполняться ровно под нагрузкой, ради которой её и писали. Прежние 200m
  # были выведены не из бюджета вызова, а по образцу соседних контейнеров.
  # Потолок ПАМЯТИ остаётся: там радиус поражения — узел, и отказ громкий.
  resources:
    requests:
      cpu: 10m
      memory: 16Mi
    limits:
      memory: 64Mi
{{- end -}}
