.idea/
.vscode/
.DS_Store
# helm-dep артефакты (Bitnami / OCI / external charts) — большие, скачиваются `helm dep up`.
# kaname — наш local sub-chart, source-of-truth, поэтому НЕ игнорируем его и его файлы.
# `helm dep update` распаковывает зависимости в helm/umbrella/tmpcharts-<pid>/ и
# удаляет каталог сам — но при обрыве (или при `git add` во время прогона) он
# остаётся, и архивы зависимостей уезжают в коммит. Один такой уже уехал.
helm/umbrella/tmpcharts-*/
helm/umbrella/charts/*.tgz
helm/umbrella/charts/ingress-nginx/
helm/umbrella/charts/postgresql/
helm/umbrella/charts/zitadel/
helm/umbrella/charts/api-gateway/
helm/umbrella/charts/compute/
helm/umbrella/charts/resource-manager/
helm/umbrella/charts/ui/
helm/umbrella/charts/vpc/
# KAC-NLB: kacho-nlb sub-chart is materialised by `helm dep update` from the
# sibling repo (file://../../../kacho-nlb/deploy). Ignore the extracted copy
# the same way we do for vpc/compute/api-gateway/ui above.
helm/umbrella/charts/kacho-nlb/
helm/umbrella/Chart.lock
ci/.seeded-ids.env
# KAC-NLB: seed-nlb-fixtures.sh writes generated ids here for downstream
# newman / e2e harnesses; never check the values in.
.seeded-ids.env
.claude/worktrees/

# карта идентификаторов содержимого локальных образов — генерируется `make build-services`,
# значения машинно-локальны (id образов конкретного docker-демона).
helm/umbrella/values.image-ids.yaml

# отпечаток последней материализации зависимостей умбреллы (scripts/helm-umbrella-deps.sh):
# машинно-локальный результат, как и сами charts/*.tgz выше.
helm/umbrella/.kacho-deps-fingerprint

# отметка «условие не создано» того же владельца: удалённый источник чартов не
# ответил. След ОДНОГО прогона (снимается в начале каждого следующего), а не
# состояние дерева — коммитить её значило бы объявить условие несозданным навсегда.
helm/umbrella/.kacho-deps-precondition-unmet

# отпечаток содержимого доставки манифестов модулей — пишет `make
# module-manifests-configmap` на каждом подъёме стенда (kacho#1981). Значение
# есть отпечаток ДЕРЕВА НА МОМЕНТ ВЫКАТКИ, а не состояние дерева: закоммитить
# его значило бы объявить привязку исполненной для чужой ревизии.
helm/umbrella/values.module-manifests.yaml
