#
# Базовая конфигурация проб старта notify — ОДНА на все пробы (CX1-79).
#
# Читают её пробы этого пакета (E04, G01, G06, G15, сумма сроков) и проба
# старта процесса в cmd/notify. Каждое отрицание меняет ровно одну строку и
# утверждает имя СВОЕЙ ручки, поэтому отказ по чужой причине не зеленит пробу.
#
# Пути файлов удостоверения пира — образцовые: пробы конфигурации судят только
# их заданность, а проба процесса подставляет файлы, выпущенные в своём
# временном каталоге.
#
# Адрес ретранслятора — действительный адрес без имени пользователя (CX1-79):
# ручка `notify.smtp.connectionURI` обязательна (полоса N13, Д44), и фикстура
# без неё зеленила бы отрицания по чужой причине. Адрес отправителя — тоже
# обязательная ручка (З20 «Отправитель»): его домен — домен `From`, по которому
# страж DNS установки строит имена запросов (§12а, Д101).
#
# Ручки DNS установки (полоса N14, §12а, NTF1-P13) — значения внутри границ;
# зона стенда выключена (`off`, Д104). Пути ключа и селектора DKIM здесь НЕ
# стоят: пару RSA 2048 выпускает проба в своём каталоге формы kubelet
# (`..data` → поколение), как `peerTLSFiles` — сертификат пира.
KACHO_NOTIFY_AUTH_MODE=production
KACHO_NOTIFY_PEER_TLS_CERT_FILE=/var/run/kacho/notify/tls/tls.crt
KACHO_NOTIFY_PEER_TLS_KEY_FILE=/var/run/kacho/notify/tls/tls.key
KACHO_NOTIFY_PEER_TLS_CA_FILE=/var/run/kacho/notify/tls/ca.crt
KACHO_NOTIFY_DB_HOST=notify-postgres
KACHO_NOTIFY_DB_PORT=5432
KACHO_NOTIFY_DB_USER=notify
KACHO_NOTIFY_DB_PASSWORD=fixture-value-not-a-credential
KACHO_NOTIFY_DB_NAME=kacho_notify
KACHO_NOTIFY_DB_SSLMODE=require
KACHO_NOTIFY_DIAG_ADDR=127.0.0.1:9095
KACHO_NOTIFY_CLAIM_INTERVAL=30s
KACHO_NOTIFY_RESOLVE_SEND_TIMEOUT=5s
KACHO_NOTIFY_SMTP_SESSION_TIMEOUT=60s
KACHO_NOTIFY_SMTP_CONNECTION_URI=smtp://relay.example.invalid:587/
KACHO_NOTIFY_SMTP_FROM_ADDRESS=notify@example.invalid
KACHO_NOTIFY_ORIGIN=https://console.example.invalid
KACHO_NOTIFY_SOURCES=[{"module":"kaname","feedAddr":"kaname-internal:9091","san":"spiffe://kacho.cloud/ns/kacho/sa/kaname","classes":["security"],"recipientForms":["address"],"authorization":"certificate"},{"module":"probe","feedAddr":"notify-probe:9091","san":"spiffe://kacho.cloud/ns/kacho/sa/kacho-notify-probe","classes":["notice"],"recipientForms":[],"authorization":"resolveSend"}]
KACHO_NOTIFY_RECIPIENT_KEY=fixture-recipient-key-not-a-secret-0123456789
# Ручки лимитов Р10 (полоса N7, NTF1-H08): сетка, потолок потока и ручки на
# источник — по записи на каждый модуль перечня KACHO_NOTIFY_SOURCES.
KACHO_NOTIFY_LIMITS_RECIPIENT_SECURITY_PER_DAY=40
KACHO_NOTIFY_LIMITS_RECIPIENT_NOTICE_PER_HOUR=20
KACHO_NOTIFY_LIMITS_RECIPIENT_NOTICE_PER_DAY=100
KACHO_NOTIFY_LIMITS_GLOBAL_PER_DAY=100000
KACHO_NOTIFY_SOURCE_LIMITS={"kaname":{"rate":10,"burst":20,"paused":false},"probe":{"rate":5,"burst":5,"paused":false}}
# Ручки DNS установки (Р19, §12а): срок стража старта и интервал перепроверки.
KACHO_NOTIFY_DNS_BOOT_DEADLINE=2m
KACHO_NOTIFY_DNS_RECHECK_INTERVAL=1h
KACHO_NOTIFY_STAND_DNS=off
KACHO_NOTIFY_DB_MAX_CONNS=10
# Ручки NTF-4 стадии S1 (приёмка NTF-4 Р16, DoD S1 п.5) — значения внутри
# границ таблицы Р16, поставляемые там, где они названы. Каталог ключа
# отпечатка (`KACHO_NOTIFY_ADDRESS_KEY_DIR`, Р15, Д23) здесь НЕ стоит: каталог
# формы kubelet с файлом ключа выпускает проба, как пару DKIM.
KACHO_NOTIFY_FEEDBACK_MAILBOX_ADDR=pop3.example.invalid:995
KACHO_NOTIFY_FEEDBACK_MAILBOX_LOCAL_PART=bounces
KACHO_NOTIFY_RETURN_DOMAIN=bounce.example.invalid
KACHO_NOTIFY_FEEDBACK_POLL_INTERVAL=1m
KACHO_NOTIFY_FEEDBACK_POLL_STALE_MAX=30m
KACHO_NOTIFY_FEEDBACK_MAX_MESSAGE_BYTES=10485760
KACHO_NOTIFY_FEEDBACK_MAX_EXPANSION_RATIO=20
KACHO_NOTIFY_FEEDBACK_CANARY_INTERVAL=1h
KACHO_NOTIFY_FEEDBACK_CANARY_DEADLINE=15m
KACHO_NOTIFY_FEEDBACK_LEASE_TTL=3m
KACHO_NOTIFY_SENT_LOG_RETENTION=720h
KACHO_NOTIFY_SUPPRESSION_HARD_TTL=72h
KACHO_NOTIFY_SUPPRESSION_SOFT_THRESHOLD=3
KACHO_NOTIFY_SUPPRESSION_SOFT_WINDOW=72h
KACHO_NOTIFY_SUPPRESSION_SOFT_TTL=24h
KACHO_NOTIFY_SUPPRESSION_SWEEP_INTERVAL=1h
KACHO_NOTIFY_SECRET_RELOAD_INTERVAL=30s
KACHO_NOTIFY_REPUTATION_HARD_BOUNCE_RATE_MAX=0.02
KACHO_NOTIFY_REPUTATION_COMPLAINT_RATE_MAX=0.001
KACHO_NOTIFY_REPUTATION_WINDOW=24h
