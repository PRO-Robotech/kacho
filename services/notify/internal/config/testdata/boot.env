#
# Базовая конфигурация проб старта notify — ОДНА на все пробы (CX1-79).
#
# Читают её пробы этого пакета (E04, G01, G06, G15, сумма сроков) и проба
# старта процесса в cmd/notify. Каждое отрицание меняет ровно одну строку и
# утверждает имя СВОЕЙ ручки, поэтому отказ по чужой причине не зеленит пробу.
#
# Пути файлов удостоверения пира — образцовые: пробы конфигурации судят только
# их заданность, а проба процесса подставляет файлы, выпущенные в своём
# временном каталоге.
#
# Адреса ретранслятора здесь нет: ручку `notify.smtp.connectionURI` и её
# обязательность заводит полоса N13 и она же дописывает сюда адрес (CX1-79).
KACHO_NOTIFY_AUTH_MODE=production
KACHO_NOTIFY_PEER_TLS_CERT_FILE=/var/run/kacho/notify/tls/tls.crt
KACHO_NOTIFY_PEER_TLS_KEY_FILE=/var/run/kacho/notify/tls/tls.key
KACHO_NOTIFY_PEER_TLS_CA_FILE=/var/run/kacho/notify/tls/ca.crt
KACHO_NOTIFY_DB_HOST=notify-postgres
KACHO_NOTIFY_DB_PORT=5432
KACHO_NOTIFY_DB_USER=notify
KACHO_NOTIFY_DB_PASSWORD=fixture-value-not-a-credential
KACHO_NOTIFY_DB_NAME=kacho_notify
KACHO_NOTIFY_DB_SSLMODE=require
KACHO_NOTIFY_DIAG_ADDR=127.0.0.1:9095
KACHO_NOTIFY_CLAIM_INTERVAL=30s
KACHO_NOTIFY_RESOLVE_SEND_TIMEOUT=5s
KACHO_NOTIFY_SMTP_SESSION_TIMEOUT=60s
KACHO_NOTIFY_ORIGIN=https://console.example.invalid
KACHO_NOTIFY_SOURCES=[{"module":"kaname","feedAddr":"kaname-internal:9091","san":"spiffe://kacho.cloud/ns/kacho/sa/kaname","classes":["security"],"recipientForms":["address"],"authorization":"certificate"},{"module":"probe","feedAddr":"notify-probe:9091","san":"spiffe://kacho.cloud/ns/kacho/sa/kacho-notify-probe","classes":["notice"],"recipientForms":[],"authorization":"resolveSend"}]
