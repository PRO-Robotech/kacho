{{- /* Общий макет письма notify (З25): табличная вёрстка, стили только inline,
ни одного обращения к внешнему ресурсу (NTF1-G03). Значения экранирует
html/template по контексту. */ -}}
<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f5f7;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#f4f5f7;">
<tr>
<td align="center" style="padding:24px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background-color:#ffffff;border:1px solid #e1e4e8;border-radius:6px;">
<tr>
<td style="padding:20px 32px;border-bottom:1px solid #e1e4e8;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;color:#24292f;">{{.Brand}}</td>
</tr>
<tr>
<td style="padding:24px 32px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:22px;color:#24292f;">
{{- range .Blocks}}
{{- if eq .Kind "heading"}}
<h1 style="margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:20px;line-height:28px;font-weight:bold;color:#24292f;">{{.Text}}</h1>
{{- else if eq .Kind "p"}}
<p style="margin:0 0 16px 0;">{{.Text}}</p>
{{- else if eq .Kind "warning"}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin:0 0 16px 0;">
<tr>
<td style="padding:12px 16px;background-color:#fff8c5;border-left:4px solid #bf8700;color:#24292f;">{{.Text}}</td>
</tr>
</table>
{{- else if eq .Kind "code"}}
<p style="margin:0 0 16px 0;padding:12px 16px;background-color:#f6f8fa;border:1px solid #e1e4e8;border-radius:6px;font-family:Consolas,Menlo,monospace;font-size:20px;letter-spacing:2px;color:#24292f;">{{.Text}}</p>
{{- else if eq .Kind "button"}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 24px 0;">
<tr>
<td style="border-radius:6px;background-color:#0969da;">
<a href="{{.Href}}" style="display:inline-block;padding:12px 24px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:6px;">{{.Label}}</a>
</td>
</tr>
</table>
{{- else if eq .Kind "list"}}
<ul style="margin:0 0 16px 0;padding:0 0 0 24px;">
{{- range .Items}}
<li style="margin:0 0 4px 0;">{{.}}</li>
{{- end}}
</ul>
{{- else if eq .Kind "kv"}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px 0;">
{{- range .Pairs}}
<tr>
<td style="padding:2px 16px 2px 0;color:#57606a;vertical-align:top;">{{.Key}}</td>
<td style="padding:2px 0;color:#24292f;vertical-align:top;">{{.Value}}</td>
</tr>
{{- end}}
</table>
{{- else if eq .Kind "divider"}}
<hr style="margin:24px 0;border:0;border-top:1px solid #e1e4e8;">
{{- end}}
{{- end}}
</td>
</tr>
</table>
</td>
</tr>
</table>
</body>
</html>
