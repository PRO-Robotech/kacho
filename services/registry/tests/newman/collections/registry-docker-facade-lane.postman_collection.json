{
  "info": {
    "_postman_id": "3b97bea1-12a7-51c9-8fb8-d9ffd01ea4de",
    "name": "kacho-registry / newman / registry-docker-facade-lane",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runId') || pm.environment.get('runId') === '') {",
          "  const t = Date.now().toString(36);",
          "  const r = Math.floor(Math.random() * 1e9).toString(36);",
          "  pm.environment.set('runId', (t + r).replace(/[^a-z0-9]/g, '').slice(-10));",
          "}",
          "pm.environment.set('_suiteProjectId', pm.environment.get('existingProjectId'));",
          "pm.environment.set('_suiteProjectCrossId', pm.environment.get('existingProjectCrossId'));",
          "pm.environment.set('_suiteRegionId', pm.environment.get('existingRegionId'));",
          "pm.environment.set('_suiteRegionAltId', pm.environment.get('existingRegionAltId'));",
          "// Default auth: project-editor JWT on project A (sufficient for most happy-path steps).",
          "// Per-step auth= overrides via _auth_pre_script.",
          "const __defaultJwt = pm.environment.get('jwtProjectEditorA') || pm.variables.get('jwtProjectEditorA') || '';",
          "if (__defaultJwt && !pm.request.headers.has('Authorization')) {",
          "  pm.request.headers.upsert({key: 'Authorization', value: 'Bearer ' + __defaultJwt});",
          "}",
          "const __needed = ['baseUrl', 'existingProjectId', 'existingRegionId', 'jwtProjectEditorA'];",
          "const __missing = __needed.filter((k) => !(pm.environment.get(k) || pm.variables.get(k) || ''));",
          "if (__missing.length > 0) {",
          "  pm.test('FIXTURE REQUIRED: ' + __missing.join(', '), () => pm.expect.fail('the suite fixture seed did not run: ' + __missing.join(', ') + ' are empty. Seed via tests/authz-fixtures (prodrun.sh patches the suite env). An empty id is not a skip — it is sent as-is and the request is refused on authorization, so every later failure names the wrong cause.'));",
          "  pm.execution.skipRequest();",
          "}",
          "(function () {",
          "  var _u = '';",
          "  try { _u = pm.request.url.toString(); } catch (e) { return; }",
          "  var _all = _u.match(/\\{\\{[A-Za-z0-9_]+\\}\\}/g);",
          "  if (!_all) { return; }",
          "  var _n = null;",
          "  for (var _i = 0; _i < _all.length; _i++) {",
          "    var _c = _all[_i].slice(2, -2);",
          "    if (!pm.variables.has(_c)) { _n = _c; break; }",
          "  }",
          "  if (_n === null) { return; }",
          "  pm.test('предусловие: {{' + _n + '}} не было захвачено — запрос не отправлен', function () {",
          "    pm.expect.fail(_n + ' не определена ни в одной области. Мутация, которая должна была её захватить, не вернула Operation (была отвергнута), либо захват не состоялся. Отправка ушла бы литералом и повтор не сошёлся бы никогда.');",
          "  });",
          "  pm.execution.skipRequest();",
          "})();"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "IBT-14-DOCKER-CHALLENGE-NAMES-THE-FACADE-HANDLE — Registry data-plane 401 challenge advertises the iam /iam/token handle (never the provider token endpoint), and that handle is a live gate",
      "description": "class:SEC | class:CONF | class:NEG | priority:P0",
      "item": [
        {
          "name": "dataplane-anonymous-challenge",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// AZD per-step: anonymous (strip Authorization header)",
                  "pm.request.headers.remove('Authorization');",
                  "// HARNESS-CONFIG GUARD — registryDataPlaneBaseUrl передаёт прогонщик (--env-var).",
                  "// Нет значения = харнесс сломан, а НЕ законный режим: сперва упасть, потом пропустить.",
                  "const __cfgUrl = pm.environment.get('registryDataPlaneBaseUrl') || pm.variables.get('registryDataPlaneBaseUrl') || '';",
                  "if (__cfgUrl) {",
                  "  pm.request.url = __cfgUrl + pm.variables.replaceIn('/v2/');",
                  "} else {",
                  "  pm.test('harness config: registryDataPlaneBaseUrl задана — docker lane — the challenge a docker client actually follows', () => {",
                  "    pm.expect.fail('registryDataPlaneBaseUrl не задана — прогонщик (deploy/scripts/newman-parallel.sh --env-var) её не передал. Шаг исполнен быть не может, а проверка, которая не может исполниться, НЕ ВПРАВЕ быть молча выброшенной.');",
                  "  });",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registry data-plane challenge: запрос получил ОТВЕТ (пусто ⇒ транспорт, а не поведение)', () => {",
                  "  pm.expect(pm.response, 'ответа нет вовсе — сеть/TLS/таймаут, а не отказ сервиса').to.not.be.undefined;",
                  "  pm.expect(pm.response.code, 'HTTP-кода нет — обмен не завершился').to.be.a('number');",
                  "});",
                  "pm.test('anonymous /v2/ is challenged with 401 (a 200 here would mean the data '",
                  "  + 'plane needs no token at all)', () => pm.expect(pm.response.code, pm.response.text()).to.eql(401));",
                  "const _wa = pm.response.headers.get('WWW-Authenticate') || '';",
                  "pm.test('the challenge is a Bearer token-auth challenge', () => {",
                  "  pm.expect(_wa, 'WWW-Authenticate header').to.match(/^Bearer /);",
                  "  pm.expect(_wa, _wa).to.match(/service=\"[^\"]+\"/);",
                  "});",
                  "const _m = _wa.match(/realm=\"([^\"]+)\"/);",
                  "pm.test('the challenge names a realm', () => pm.expect(_m && _m[1], _wa).to.be.a('string'));",
                  "const _realm = (_m && _m[1]) || '';",
                  "const _path = _realm.replace(/^[a-z]+:\\/\\/[^/]+/i, '');",
                  "pm.test('the realm PATH is the facade docker-token handle', () => {",
                  "  pm.expect(_path, 'realm ' + _realm + ' — the docker client follows this address; it must be iam\\'s handle').to.eql('/iam/token');",
                  "});",
                  "pm.test('the realm is NOT the provider token endpoint (that would route every '",
                  "  + 'docker client around the facade, silently)', () => {",
                  "  pm.expect(_realm.toLowerCase(), _realm).to.not.contain('/oauth2/');",
                  "});",
                  "pm.environment.set('ibtRealmPath', _path);"
                ]
              }
            }
          ]
        },
        {
          "name": "facade-token-handle-is-a-gate",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iam/token?service=registry.kacho.local&scope=repository:ibt/{{runId}}:pull",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iam",
                "token?service=registry.kacho.local&scope=repository:ibt",
                "{{runId}}:pull"
              ]
            }
          },
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// AZD per-step: anonymous (strip Authorization header)",
                  "pm.request.headers.remove('Authorization');",
                  "// HARNESS-CONFIG GUARD — iamRegistryTokenBaseUrl передаёт прогонщик (--env-var).",
                  "// Нет значения = харнесс сломан, а НЕ законный режим: сперва упасть, потом пропустить.",
                  "const __cfgUrl = pm.environment.get('iamRegistryTokenBaseUrl') || pm.variables.get('iamRegistryTokenBaseUrl') || '';",
                  "if (__cfgUrl) {",
                  "  pm.request.url = __cfgUrl + pm.variables.replaceIn('/iam/token?service=registry.kacho.local&scope=repository:ibt/{{runId}}:pull');",
                  "} else {",
                  "  pm.test('harness config: iamRegistryTokenBaseUrl задана — docker lane — the facade handle the challenge points at', () => {",
                  "    pm.expect.fail('iamRegistryTokenBaseUrl не задана — прогонщик (deploy/scripts/newman-parallel.sh --env-var) её не передал. Шаг исполнен быть не может, а проверка, которая не может исполниться, НЕ ВПРАВЕ быть молча выброшенной.');",
                  "  });",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('facade docker-token handle: запрос получил ОТВЕТ (пусто ⇒ транспорт, а не поведение)', () => {",
                  "  pm.expect(pm.response, 'ответа нет вовсе — сеть/TLS/таймаут, а не отказ сервиса').to.not.be.undefined;",
                  "  pm.expect(pm.response.code, 'HTTP-кода нет — обмен не завершился').to.be.a('number');",
                  "});",
                  "pm.test('the handle EXISTS and refuses an anonymous caller (404 = advertised but '",
                  "  + 'not served; 200 = anonymous issuance)', () => pm.expect(pm.response.code, pm.response.text()).to.eql(401));",
                  "const _wa = pm.response.headers.get('WWW-Authenticate') || '';",
                  "pm.test('the handle re-challenges with its own realm, and it is the same handle', () => {",
                  "  const m = _wa.match(/realm=\"([^\"]+)\"/);",
                  "  pm.expect(m && m[1], _wa).to.be.a('string');",
                  "  const p = (m && m[1] || '').replace(/^[a-z]+:\\/\\/[^/]+/i, '');",
                  "  pm.expect(p, 'the facade advertises ' + p + ' while the data plane advertises '",
                  "    + pm.environment.get('ibtRealmPath')).to.eql(pm.environment.get('ibtRealmPath'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "facade-token-handle-rejects-garbage-credentials",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iam/token?service=registry.kacho.local&scope=repository:ibt/{{runId}}:pull",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iam",
                "token?service=registry.kacho.local&scope=repository:ibt",
                "{{runId}}:pull"
              ]
            }
          },
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// AZD per-step: anonymous (strip Authorization header)",
                  "pm.request.headers.remove('Authorization');",
                  "// HARNESS-CONFIG GUARD — iamRegistryTokenBaseUrl передаёт прогонщик (--env-var).",
                  "// Нет значения = харнесс сломан, а НЕ законный режим: сперва упасть, потом пропустить.",
                  "const __cfgUrl = pm.environment.get('iamRegistryTokenBaseUrl') || pm.variables.get('iamRegistryTokenBaseUrl') || '';",
                  "if (__cfgUrl) {",
                  "  pm.request.url = __cfgUrl + pm.variables.replaceIn('/iam/token?service=registry.kacho.local&scope=repository:ibt/{{runId}}:pull');",
                  "} else {",
                  "  pm.test('harness config: iamRegistryTokenBaseUrl задана — docker lane — the handle must verify credentials, not merely accept them', () => {",
                  "    pm.expect.fail('iamRegistryTokenBaseUrl не задана — прогонщик (deploy/scripts/newman-parallel.sh --env-var) её не передал. Шаг исполнен быть не может, а проверка, которая не может исполниться, НЕ ВПРАВЕ быть молча выброшенной.');",
                  "  });",
                  "  pm.execution.skipRequest();",
                  "}",
                  "pm.request.headers.upsert({key: 'Authorization', value: 'Basic ' +",
                  "  CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(",
                  "    'ibt-not-a-real-key:ibt-not-a-real-secret'))});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('facade docker-token handle, garbage credentials: запрос получил ОТВЕТ (пусто ⇒ транспорт, а не поведение)', () => {",
                  "  pm.expect(pm.response, 'ответа нет вовсе — сеть/TLS/таймаут, а не отказ сервиса').to.not.be.undefined;",
                  "  pm.expect(pm.response.code, 'HTTP-кода нет — обмен не завершился').to.be.a('number');",
                  "});",
                  "pm.test('unverifiable credentials are refused, never brokered into a token',",
                  "  () => pm.expect(pm.response.code, pm.response.text()).to.eql(401));",
                  "pm.test('no token was handed out', () => {",
                  "  let j = null; try { j = pm.response.json(); } catch (e) { j = null; }",
                  "  pm.expect(j && j.token, JSON.stringify(j)).to.be.oneOf([undefined, null]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "facade-token-listener-serves-only-its-handle",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ibt-nonsense-{{runId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ibt-nonsense-{{runId}}"
              ]
            }
          },
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// AZD per-step: anonymous (strip Authorization header)",
                  "pm.request.headers.remove('Authorization');",
                  "// HARNESS-CONFIG GUARD — iamRegistryTokenBaseUrl передаёт прогонщик (--env-var).",
                  "// Нет значения = харнесс сломан, а НЕ законный режим: сперва упасть, потом пропустить.",
                  "const __cfgUrl = pm.environment.get('iamRegistryTokenBaseUrl') || pm.variables.get('iamRegistryTokenBaseUrl') || '';",
                  "if (__cfgUrl) {",
                  "  pm.request.url = __cfgUrl + pm.variables.replaceIn('/ibt-nonsense-{{runId}}');",
                  "} else {",
                  "  pm.test('harness config: iamRegistryTokenBaseUrl задана — docker lane — control proving the 401s above are the HANDLE answering, not a listener that refuses everything', () => {",
                  "    pm.expect.fail('iamRegistryTokenBaseUrl не задана — прогонщик (deploy/scripts/newman-parallel.sh --env-var) её не передал. Шаг исполнен быть не может, а проверка, которая не может исполниться, НЕ ВПРАВЕ быть молча выброшенной.');",
                  "  });",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('facade token listener, nonsense path: запрос получил ОТВЕТ (пусто ⇒ транспорт, а не поведение)', () => {",
                  "  pm.expect(pm.response, 'ответа нет вовсе — сеть/TLS/таймаут, а не отказ сервиса').to.not.be.undefined;",
                  "  pm.expect(pm.response.code, 'HTTP-кода нет — обмен не завершился').to.be.a('number');",
                  "});",
                  "pm.test('a path that is NOT the handle is 404, so the 401s above came from the handle itself', () => pm.expect(pm.response.code, pm.response.text()).to.eql(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": []
}