  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runId') || pm.environment.get('runId') === '') {",
          "  // runId формат: только [a-z0-9], без точки, начинается с буквы — чтобы проходить compute name regex",
          "  const t = Date.now().toString(36);",
          "  const r = Math.floor(Math.random() * 1e9).toString(36);",
          "  pm.environment.set('runId', ('r' + t + r).replace(/[^a-z0-9]/g, '').slice(0, 11));",
          "}",
          "pm.environment.set('_suiteProjectId', pm.environment.get('existingProjectId'));",
          "pm.environment.set('_suiteProjectCrossId', pm.environment.get('existingProjectCrossId'));",
          "const __defaultJwt = pm.environment.get('jwtBootstrap') || pm.variables.get('jwtBootstrap') || '';",
          "if (__defaultJwt && !pm.request.headers.has('Authorization')) {",
          "  pm.request.headers.upsert({key: 'Authorization', value: 'Bearer ' + __defaultJwt});",
          "}",
          "(function () {",
          "  var _u = '';",
          "  try { _u = pm.request.url.toString(); } catch (e) { return; }",
          "  var _all = _u.match(/\\{\\{[A-Za-z0-9_]+\\}\\}/g);",
          "  if (!_all) { return; }",
          "  var _n = null;",
          "  for (var _i = 0; _i < _all.length; _i++) {",
          "    var _c = _all[_i].slice(2, -2);",
          "    if (!pm.variables.has(_c)) { _n = _c; break; }",
          "  }",
          "  if (_n === null) { return; }",
          "  pm.test('предусловие: {{' + _n + '}} не было захвачено — запрос не отправлен', function () {",
          "    pm.expect.fail(_n + ' не определена ни в одной области. Мутация, которая должна была её захватить, не вернула Operation (была отвергнута), либо захват не состоялся. Отправка ушла бы литералом и повтор не сошёлся бы никогда.');",
          "  });",
          "  pm.execution.skipRequest();",
          "})();"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "IVOL-ATTACH-EXTERNAL-ABSENT — POST /kacho.cloud.storage.v1.InternalVolumeService/Attach на external endpoint → not served there (Internal-only :9091, ban #6/INV-7)",
      "description": "class:SEC | class:NEG | class:AUTHZ | priority:P0",
      "item": [
        {
          "name": "attach",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/kacho.cloud.storage.v1.InternalVolumeService/Attach",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "kacho.cloud.storage.v1.InternalVolumeService",
                "Attach"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('InternalVolumeService not exposed on external endpoint', () => pm.expect(pm.response.code).to.be.oneOf([403, 404, 405, 501]));",
                  "let _d; try { _d = pm.response.json(); } catch (e) { _d = null; }",
                  "pm.test('403 here must be an UNCATALOGUED-method denial, not a permission check on a live route', () => {",
                  "  if (pm.response.code !== 403) return;",
                  "  const types = [];",
                  "  ((_d && _d.details) || []).forEach(d => ((d && d.violations) || []).forEach(v => types.push(v && v.type)));",
                  "  pm.expect(types, JSON.stringify(_d)).to.include('authz.catalog');",
                  "});",
                  "pm.test('no attach-CAS leak (never reaches storage on external)', () => pm.expect(JSON.stringify(_d || {}).toLowerCase()).to.not.include('sqlstate'));"
                ]
              }
            }
          ]
        }
      ]
    },
