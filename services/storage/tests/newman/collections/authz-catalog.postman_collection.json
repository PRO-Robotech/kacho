                "type": "text/javascript",
                "exec": [
                  "pm.test('[SDT-LS-ANON] UNAUTH: status 401', () => pm.expect(pm.response.code, pm.response.text()).to.equal(401));",
                  "let j; try { j = pm.response.json(); } catch(e) { j = null; }",
                  "pm.test('[SDT-LS-ANON] UNAUTH: grpc code 16 (UNAUTHENTICATED)', () => pm.expect(j && j.code, JSON.stringify(j)).to.equal(16));"
                ]
              }
