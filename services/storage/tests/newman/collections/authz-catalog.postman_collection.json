                  "let j; try { j = pm.response.json(); } catch(e) { j = null; }",
                  "pm.test('[SDT-LS-NOB] ALLOW: not an error envelope', () => pm.expect(j && j.code, JSON.stringify(j)).to.be.oneOf([undefined, null]));"
                ]
