      "description": "class:CRUD | priority:P0",
      "item": [
        {
          "name": "trigger-create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/nlb/v1/networkLoadBalancers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "nlb",
                "v1",
                "networkLoadBalancers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"projectId\": \"{{_suiteProjectId}}\", \"regionId\": \"{{_suiteRegionId}}\", \"name\": \"opget-inflight-{{runId}}\", \"placement\": \"EXTERNAL_REGIONAL\", \"v4Source\": {\"public\": {}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.environment.set('opId', '');",
                  "try {",
                  "  const j = pm.response.json();",
                  "  const v = (j.id);",
                  "  if (v !== undefined && v !== null) pm.environment.set('opId', String(v));",
                  "} catch (e) {}",
                  "try {",
                  "  const j = pm.response.json();",
                  "  const v = (j.metadata && j.metadata.networkLoadBalancerId);",
                  "  if (v !== undefined && v !== null) pm.environment.set('nlbId', String(v));",
                  "} catch (e) {}",
                  "pm.test('done initially false or true', () => {  const j = pm.response.json();  pm.expect(typeof j.done).to.eql('boolean');});"
                ]
              }
            }
          ]
        },
        {
          "name": "get-op-immediate-rya782",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/operations/{{opId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operations",
                "{{opId}}"
