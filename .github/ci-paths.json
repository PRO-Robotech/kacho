   ],
   "paths": [
    "ui-future/**",
    "proto/**"
   ],
   "local": [
    {
     "kind": "cmd",
     "title": "консоль — типы",
     "argv": [
      "npm",
      "--prefix",
      "ui-future",
      "run",
      "typecheck"
     ]
    },
    {
     "kind": "cmd",
     "title": "консоль — линт",
     "argv": [
      "npm",
      "--prefix",
      "ui-future",
      "run",
      "lint"
     ]
    },
    {
     "kind": "stand",
     "title": "сквозные пробы консоли — нужен стенд"
    }
   ]
  },
  {
   "id": "ui-go-module",
   "why": "две пробы общего пакета консоли (@shared/test/corelib-source) читают объявление фундамента из кэша модулей той версии, что закреплена корневым go.mod; задание ui.yml:test выкачивает её по go.mod — правка go.mod/go.sum меняет их вход",
   "jobs": [
    "ui.yml:test"
   ],
   "paths": [
    "go.mod",
    "go.sum"
   ],
   "local": [
    {
     "kind": "cmd",
     "title": "консоль — юниты пакета vpc (несёт пробы общего пакета, читающие фундамент)",
     "argv": [
      "npm",
      "--prefix",
      "ui-future/vpc",
      "test"
     ]
    }
   ]
