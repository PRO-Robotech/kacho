    "**/.trivyignore*",
    "deploy/**",
    "services/*/deploy/**",
    "gateway/deploy/**"
   ],
   "local": [
    {
     "kind": "stand",
     "title": "trivy fs + IaC — судит конвейер"
    }
   ]
  },
  {
   "id": "ui",
   "why": "консоль: типы, линт, федерация, юниты, сборка пакетов",
   "jobs": [
    "ui.yml:typecheck",
    "ui.yml:lint",
    "ui.yml:federation",
